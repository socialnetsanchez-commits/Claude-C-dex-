//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  CH Zone Signals by Sanchez · Pine Script v6
//  Dos herramientas:
//   1) Zonas BUY / SELL de temporalidades superiores ("H1 SELL", "M30 BUY"...)
//      filtradas a favor de la EMA 50 y de la estructura mayor de esa TF.
//   2) Order blocks swing filtrados a favor de la EMA 200, de la estructura
//      mayor y con volumen por encima de la media en su origen. Los OB A+
//      están además dentro de una zona BUY / SELL de temporalidad superior.
//  Los filtros se eligieron midiendo la reacción en datos reales (EURUSD H1,
//  S&P 500 y GOOG diarios, separando dentro y fuera de muestra). La tabla
//  mide la reacción en TU gráfico: es una estadística, no una promesa.
//  Sin repintado: pivotes confirmados y zonas MTF con [1] + lookahead_on.
//  No es asesoramiento financiero.
// ════════════════════════════════════════════════════════════════════════════
indicator("CH Zone Signals by Sanchez", shorttitle = "CH Zones", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ─────────────────────────────── Constantes ────────────────────────────────
const string G_ZN = "1 · Zonas BUY / SELL"
const string G_OB = "2 · Order blocks swing"
const string G_ST = "3 · Medición de la reacción"
const string G_UI = "4 · Estilo"

const string ST_SOLID  = "Continua"
const string ST_DASHED = "Discontinua"
const string ST_DOTTED = "Punteada"
const string SZ_TINY   = "Diminuto"
const string SZ_SMALL  = "Pequeño"
const string SZ_NORMAL = "Normal"
const string POS_TR    = "Arriba derecha"
const string POS_TL    = "Arriba izquierda"
const string POS_BR    = "Abajo derecha"
const string POS_BL    = "Abajo izquierda"
const string MIT_CLOSE = "Cierre"
const string MIT_WICK  = "Mecha"
const string TH_DARK   = "Oscuro"
const string TH_LIGHT  = "Claro"
const int    BUF       = 400    // velas guardadas para localizar order blocks

// ═══════════════════════════════ INPUTS ════════════════════════════════════
// 1 · Zonas BUY / SELL de temporalidades superiores
bool   znShow     = input.bool(true, "Mostrar zonas", group = G_ZN, inline = "zs")
bool   znSellOn   = input.bool(true, "SELL", group = G_ZN, inline = "zs")
bool   znBuyOn    = input.bool(true, "BUY", group = G_ZN, inline = "zs")
bool   tf1On      = input.bool(true, "", group = G_ZN, inline = "t1")
string tf1        = input.timeframe("15", "", group = G_ZN, inline = "t1")
bool   tf2On      = input.bool(true, "", group = G_ZN, inline = "t2")
string tf2        = input.timeframe("30", "", group = G_ZN, inline = "t2")
bool   tf3On      = input.bool(true, "", group = G_ZN, inline = "t3")
string tf3        = input.timeframe("60", "", group = G_ZN, inline = "t3")
bool   tf4On      = input.bool(false, "", group = G_ZN, inline = "t4")
string tf4        = input.timeframe("240", "", group = G_ZN, inline = "t4")
bool   znNeedEma  = input.bool(true, "Solo a favor de la EMA 50 de esa temporalidad", group = G_ZN)
bool   znNeedBig  = input.bool(true, "Solo a favor de la estructura mayor de esa temporalidad", group = G_ZN)
int    znLen      = input.int(5, "Longitud de pivote", minval = 2, maxval = 50, group = G_ZN, tooltip = "La estructura mayor usa 4 veces esta longitud.")
string znMitig    = input.string(MIT_CLOSE, "Invalidación", options = [MIT_CLOSE, MIT_WICK], group = G_ZN, tooltip = "La zona desaparece en cuanto una vela de TU gráfico cierra (o perfora con la mecha) al otro lado, sin esperar al cierre de la vela de la temporalidad superior.")
int    znExt      = input.int(12, "Extensión a la derecha (barras)", minval = 0, maxval = 300, group = G_ZN)

// 2 · Order blocks swing
bool   obShow      = input.bool(true, "Mostrar order blocks swing", group = G_OB)
int    obSwingLen  = input.int(25, "Longitud de swing", minval = 5, maxval = 100, group = G_OB)
int    obBigMult   = input.int(4, "Estructura mayor = swing ×", minval = 2, maxval = 10, group = G_OB)
bool   obNeedEma   = input.bool(true, "Solo a favor de la EMA 200", group = G_OB)
bool   obNeedBig   = input.bool(true, "Solo a favor de la estructura mayor", group = G_OB)
bool   obNeedVol   = input.bool(true, "Volumen del origen > media", group = G_OB)
bool   obNeedBos   = input.bool(false, "Solo OB de continuación (BOS)", group = G_OB)
float  obMaxAtr    = input.float(3.0, "Altura máxima del OB (ATR ×)", minval = 0.2, step = 0.1, group = G_OB)
int    obMaxActive = input.int(4, "Máx. activos por lado", minval = 1, maxval = 20, group = G_OB)
string obMitig     = input.string(MIT_CLOSE, "Mitigación", options = [MIT_CLOSE, MIT_WICK], group = G_OB, inline = "om")
bool   obDelMitig  = input.bool(false, "borrar mitigados", group = G_OB, inline = "om")
bool   obAplusOn   = input.bool(true, "Resaltar OB A+ (dentro de una zona BUY / SELL de TF superior)", group = G_OB, tooltip = "En las pruebas con datos reales, los OB que coinciden con una zona de temporalidad superior reaccionaron más (84 % frente a 63 % dentro de muestra), aunque fuera de muestra solo hubo 2 casos. Se cuentan aparte en la tabla.")
bool   obTextOn    = input.bool(true, "Etiqueta con fuerza (★)", group = G_OB)
bool   obMidOn     = input.bool(true, "Línea del 50 % (referencia de entrada)", group = G_OB, inline = "omd")
string obMidStyle  = input.string(ST_DOTTED, "", options = [ST_SOLID, ST_DASHED, ST_DOTTED], group = G_OB, inline = "omd")

// 3 · Medición de la reacción
bool   statsOn  = input.bool(true, "Tabla de reacción", group = G_ST, tooltip = "Cuenta, tras el primer toque (el precio debe haber salido antes de la zona), cuántas veces el precio se aleja al menos X ATR antes de que una vela cierre al otro lado. Si ambas cosas pasan en la misma vela, cuenta como fallo.")
float  reactAtr = input.float(1.5, "Reacción mínima (ATR ×)", minval = 0.25, step = 0.25, group = G_ST)
float  reactR   = input.float(1.5, "Reacción mínima en R", minval = 0.25, step = 0.25, group = G_ST, tooltip = "R = riesgo de entrar en el borde de la zona con el stop en el borde lejano (altura de la zona, mínimo 1 ATR). Es la medida honesta en temporalidades bajas como M3: allí el ATR es pequeño frente a zonas de M15 / H1 y la medida en ATR sale inflada.")
string statsPos = input.string(POS_BR, "Posición", options = [POS_TR, POS_TL, POS_BR, POS_BL], group = G_ST)

// 4 · Estilo (solo afecta al aspecto, no a los cálculos)
string uiTheme    = input.string(TH_DARK, "Fondo del gráfico", options = [TH_DARK, TH_LIGHT], group = G_UI, tooltip = "Ajusta los textos y la tabla para que se lean bien sobre tu fondo.")
color  buyCol     = input.color(#22ab94, "BUY / alcista", group = G_UI, inline = "col")
color  sellCol    = input.color(#f7525f, "SELL / bajista", group = G_UI, inline = "col")
color  aplusCol   = input.color(#f5b83d, "OB A+", group = G_UI, inline = "col")
int    znTransp   = input.int(88, "Relleno de zonas (transparencia)", minval = 0, maxval = 100, group = G_UI)
int    obTransp   = input.int(82, "Relleno de OB (transparencia)", minval = 0, maxval = 100, group = G_UI)
bool   znMidOn    = input.bool(true, "Línea media de las zonas", group = G_UI, inline = "zm")
string znMidStyle = input.string(ST_DOTTED, "", options = [ST_SOLID, ST_DASHED, ST_DOTTED], group = G_UI, inline = "zm")
bool   znLabelOn  = input.bool(true, "Etiqueta de las zonas", group = G_UI, inline = "zl")
string znTxtSize  = input.string(SZ_SMALL, "", options = [SZ_TINY, SZ_SMALL, SZ_NORMAL], group = G_UI, inline = "zl")

// ═════════════════════════════ CÁLCULOS BASE ═══════════════════════════════
int   obBigLen  = math.min(obSwingLen * obBigMult, 450)
float atr       = ta.atr(14)
float ema200    = ta.ema(close, 200)
float volAvg    = ta.sma(volume, 20)
bool  hasVolume = ta.cum(nz(volume)) > 0

// Paleta según el fondo
bool  isDark  = uiTheme == TH_DARK
color C_NONE  = color.new(#000000, 100)
color C_TEXT  = isDark ? #d1d4dc : #131722
color C_SUB   = isDark ? #787b86 : #6a6d78
color C_CARD  = isDark ? color.new(#131722, 8) : color.new(#ffffff, 8)
color C_HEAD  = isDark ? #1e222d : #eef0f4
color C_GRID  = isDark ? #2a2e39 : #d6d9e0
color C_GOOD  = #22ab94
color C_MID   = #f5b83d
color C_BAD   = #f7525f

// ═════════════════════════════ TIPOS ═══════════════════════════════════════
type OB
    box   bx
    line  mid
    float top
    float btm
    int   dir
    float atrRef
    bool  aplus    = false
    bool  left     = false
    bool  touched  = false
    int   touchBar = na
    bool  resolved = false
    bool  resolvedR = false

// ═════════════════════════════ FUNCIONES ═══════════════════════════════════
f_lineStyle(string s) => s == ST_SOLID ? line.style_solid : s == ST_DASHED ? line.style_dashed : line.style_dotted

f_size(string s) => s == SZ_TINY ? size.tiny : s == SZ_SMALL ? size.small : size.normal

f_pos(string s) => s == POS_TR ? position.top_right : s == POS_TL ? position.top_left : s == POS_BR ? position.bottom_right : position.bottom_left

// Estructura de mercado. Un pivote máximo se confirma cuando el máximo de hace
// `len` velas supera a todas las posteriores (igual para mínimos).
// shift = true cuando la ruptura va contra la tendencia previa (MSS); si no, es BOS.
f_structure(int len) =>
    var int   leg     = 0
    var float topLvl  = na
    var int   topIdx  = na
    var bool  topOpen = false
    var float btmLvl  = na
    var int   btmIdx  = na
    var bool  btmOpen = false
    var int   trend   = 0
    float hh      = ta.highest(high, len)
    float ll      = ta.lowest(low, len)
    int   prevLeg = leg
    if high[len] > hh
        leg := 0
    else if low[len] < ll
        leg := 1
    if leg == 0 and prevLeg == 1
        topLvl  := high[len]
        topIdx  := bar_index - len
        topOpen := true
    if leg == 1 and prevLeg == 0
        btmLvl  := low[len]
        btmIdx  := bar_index - len
        btmOpen := true
    bool  brkUp  = topOpen and close > topLvl
    bool  brkDn  = not brkUp and btmOpen and close < btmLvl
    bool  shift  = false
    int   brkIdx = na
    float brkLvl = na
    if brkUp
        shift   := trend == -1
        trend   := 1
        topOpen := false
        brkIdx  := topIdx
        brkLvl  := topLvl
    else if brkDn
        shift   := trend == 1
        trend   := -1
        btmOpen := false
        brkIdx  := btmIdx
        brkLvl  := btmLvl
    [trend, brkUp, brkDn, shift, brkIdx, brkLvl]

// Valor de hace `i` velas guardado en un buffer (0 = vela actual).
// Los buffers evitan leer el historial con [] dentro de llamadas condicionales.
f_at(array<float> a, int i) => array.get(a, array.size(a) - 1 - i)

// Vela de origen del impulso: mínimo más bajo (alcista) o máximo más alto
// (bajista) entre el pivote roto y la vela actual. Devuelve [máximo, mínimo, desfase].
f_obCandle(array<float> hs, array<float> ls, bool bullish, int fromIdx) =>
    int   span = math.max(0, math.min(bar_index - fromIdx, array.size(hs) - 1))
    float ext  = bullish ? f_at(ls, 0) : f_at(hs, 0)
    int   off  = 0
    for i = 0 to span
        float v = bullish ? f_at(ls, i) : f_at(hs, i)
        if (bullish and v < ext) or (not bullish and v > ext)
            ext := v
            off := i
    [f_at(hs, off), f_at(ls, off), off]

// Calidad del OB con los criterios que mejoraron la reacción en datos reales:
// EMA 200 a favor, estructura mayor a favor, volumen del origen > media y BOS.
f_obQuality(array<float> vs, bool bullish, int off, float top, float btm, bool isShift, int bigTrend) =>
    int   nAfter = math.min(3, off)
    float vSum   = 0.0
    for i = off - nAfter to off
        vSum += f_at(vs, i)
    bool emaOk  = bullish ? close > ema200 : close < ema200
    bool bigOk  = bigTrend == (bullish ? 1 : -1)
    bool volOk  = not hasVolume or vSum / (nAfter + 1) > volAvg
    bool bosOk  = not isShift
    bool sizeOk = top - btm <= obMaxAtr * atr
    bool pass   = sizeOk and (not obNeedEma or emaOk) and (not obNeedBig or bigOk) and (not obNeedVol or volOk) and (not obNeedBos or bosOk)
    int  stars  = (emaOk ? 1 : 0) + (bigOk ? 1 : 0) + (volOk and hasVolume ? 1 : 0) + (bosOk ? 1 : 0)
    [pass, stars]

// Zonas de oferta / demanda de otra temporalidad (se evalúa con request.security).
// Solo se aceptan zonas a favor de la EMA 50 y de la estructura mayor de esa TF.
// Devuelve la última zona válida sin mitigar de cada lado, con velas ya cerradas.
f_mtfZones(int len, bool wickMitig, bool needEma, bool needBig) =>
    var array<float> hs = array.new<float>()
    var array<float> ls = array.new<float>()
    var array<int>   ts = array.new<int>()
    array.push(hs, high)
    array.push(ls, low)
    array.push(ts, time)
    if array.size(hs) > BUF
        array.shift(hs)
        array.shift(ls)
        array.shift(ts)
    [mTrend, mUp, mDn, mShift, mIdx, mLvl] = f_structure(len)
    [gTrend, gUp, gDn, gShift, gIdx, gLvl] = f_structure(len * 4)
    float e50 = ta.ema(close, 50)
    var float bearTop = na
    var float bearBtm = na
    var int   bearT   = na
    var float bullTop = na
    var float bullBtm = na
    var int   bullT   = na
    if mUp and (not needEma or close > e50) and (not needBig or gTrend == 1)
        [uH, uL, uOff] = f_obCandle(hs, ls, true, mIdx)
        bullTop := uH
        bullBtm := uL
        bullT   := array.get(ts, array.size(ts) - 1 - uOff)
    if mDn and (not needEma or close < e50) and (not needBig or gTrend == -1)
        [dH, dL, dOff] = f_obCandle(hs, ls, false, mIdx)
        bearTop := dH
        bearBtm := dL
        bearT   := array.get(ts, array.size(ts) - 1 - dOff)
    float upSrc = wickMitig ? high : close
    float dnSrc = wickMitig ? low : close
    if not na(bullBtm) and dnSrc < bullBtm
        bullTop := na
        bullBtm := na
        bullT   := na
    if not na(bearTop) and upSrc > bearTop
        bearTop := na
        bearBtm := na
        bearT   := na
    [bearTop[1], bearBtm[1], bearT[1], bullTop[1], bullBtm[1], bullT[1]]

f_tfLabel(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(int(s / 60)) : s < 86400 ? "H" + str.tostring(int(s / 3600)) : s < 604800 ? "D" + str.tostring(int(s / 86400)) : "W" + str.tostring(int(s / 604800))

// Dibuja una zona MTF en la última vela: relleno suave, borde de entrada
// marcado, borde lejano punteado, línea media y etiqueta tipo píldora.
f_zone(array<box> bxs, array<line> lns, array<label> lbs, bool ok, float top, float btm, int t, string txt, color c, bool bull) =>
    if ok and not na(top) and not na(btm) and not na(t)
        int   rightT = time + znExt * timeframe.in_seconds() * 1000
        float prox   = bull ? top : btm
        float far    = bull ? btm : top
        float mid    = (top + btm) / 2
        array.push(bxs, box.new(t, top, rightT, btm, xloc = xloc.bar_time, border_color = C_NONE, bgcolor = color.new(c, znTransp)))
        array.push(lns, line.new(t, prox, rightT, prox, xloc = xloc.bar_time, color = c, width = 2))
        array.push(lns, line.new(t, far, rightT, far, xloc = xloc.bar_time, color = color.new(c, 45), style = line.style_dotted))
        if znMidOn
            array.push(lns, line.new(t, mid, rightT, mid, xloc = xloc.bar_time, color = color.new(c, 55), style = f_lineStyle(znMidStyle)))
        if znLabelOn
            array.push(lbs, label.new(rightT, mid, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 10), textcolor = color.white, size = f_size(znTxtSize)))
    true

// Mide la reacción de la zona MTF visible: primer toque tras salir de ella y
// reacción ≥ reactAtr·ATR (medida ATR) o ≥ reactR·R (medida R) antes de que una
// vela cierre al otro lado (fallo). También indica si el gráfico ya la invalidó.
f_trackZone(float top, float btm, int t, bool bull, bool enabled) =>
    var int   zt      = na
    var float zTop    = na
    var float zBtm    = na
    var float zAtr    = na
    var bool  zLeft   = false
    var bool  zTouch  = false
    var int   zTBar   = na
    var bool  zDone   = true
    var bool  zDoneR  = true
    var bool  zBroken = false
    int  win   = 0
    int  loss  = 0
    int  winR  = 0
    int  lossR = 0
    bool first = false
    if enabled and not na(t) and not na(top) and not na(btm) and (na(zt) or t != zt or top != zTop or btm != zBtm)
        zt      := t
        zTop    := top
        zBtm    := btm
        zAtr    := atr
        zLeft   := false
        zTouch  := false
        zTBar   := na
        zDone   := false
        zDoneR  := false
        zBroken := false
    if enabled and not (zDone and zDoneR)
        bool inZone = high >= zBtm and low <= zTop
        if not zLeft and (bull ? low > zTop : high < zBtm)
            zLeft := true
        if not zTouch and zLeft and inZone
            zTouch := true
            zTBar  := bar_index
            first  := true
        if bull ? close < zBtm : close > zTop
            if zTouch and not zDone
                loss := 1
            if zTouch and not zDoneR
                lossR := 1
            zDone  := true
            zDoneR := true
        else if zTouch and bar_index > zTBar
            if not zDone and (bull ? high >= zTop + reactAtr * zAtr : low <= zBtm - reactAtr * zAtr)
                win   := 1
                zDone := true
            float distR = reactR * math.max(zTop - zBtm, zAtr)
            if not zDoneR and (bull ? high >= zTop + distR : low <= zBtm - distR)
                winR   := 1
                zDoneR := true
    // Invalidación en el gráfico (también después de una reacción)
    bool wick = znMitig == MIT_WICK
    if enabled and not na(zt) and not zBroken and (bull ? (wick ? low : close) < zBtm : (wick ? high : close) > zTop)
        zBroken := true
    [win, loss, winR, lossR, first, zBroken]

// Gestiona los OB activos: salida de la zona, primer toque, reacción y
// mitigación. Devuelve los resultados de todos y, aparte, los de los OB A+.
f_manageOBs(array<OB> arr, string mitMode, bool delMit) =>
    int  wins    = 0
    int  losses  = 0
    int  winsA   = 0
    int  lossesA = 0
    int  winsR   = 0
    int  lossesR = 0
    int  winsAR  = 0
    int  lossAR  = 0
    bool firstT  = false
    bool firstA  = false
    int  n       = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            OB    o      = array.get(arr, i)
            bool  bull   = o.dir == 1
            float srcM   = mitMode == MIT_CLOSE ? close : bull ? low : high
            bool  inZone = high >= o.btm and low <= o.top
            bool  mitig  = bull ? srcM < o.btm : srcM > o.top
            // El toque solo cuenta si antes el precio salió por completo de la zona
            if not o.left and (bull ? low > o.top : high < o.btm)
                o.left := true
            if not o.touched and o.left and inZone
                o.touched  := true
                o.touchBar := bar_index
                firstT     := true
                if o.aplus
                    firstA := true
            if mitig
                // Supuesto conservador: mitigación antes que reacción en la misma vela
                if o.touched and not o.resolved
                    o.resolved := true
                    losses     += 1
                    if o.aplus
                        lossesA += 1
                if o.touched and not o.resolvedR
                    o.resolvedR := true
                    lossesR     += 1
                    if o.aplus
                        lossAR += 1
                box.set_right(o.bx, bar_index)
                if not na(o.mid)
                    line.set_x2(o.mid, bar_index)
                if delMit
                    box.delete(o.bx)
                    if not na(o.mid)
                        line.delete(o.mid)
                array.remove(arr, i)
            else
                if o.touched and not o.resolved and bar_index > o.touchBar
                    bool reacted = bull ? high >= o.top + reactAtr * o.atrRef : low <= o.btm - reactAtr * o.atrRef
                    if reacted
                        o.resolved := true
                        wins       += 1
                        if o.aplus
                            winsA += 1
                if o.touched and not o.resolvedR and bar_index > o.touchBar
                    float distR = reactR * math.max(o.top - o.btm, o.atrRef)
                    if bull ? high >= o.top + distR : low <= o.btm - distR
                        o.resolvedR := true
                        winsR       += 1
                        if o.aplus
                            winsAR += 1
                box.set_right(o.bx, bar_index)
                if not na(o.mid)
                    line.set_x2(o.mid, bar_index)
    [wins, losses, winsA, lossesA, winsR, lossesR, winsAR, lossAR, firstT, firstA]

// ¿Se solapa el OB con una zona de TF superior válida?
f_ov(bool ok, float zTop, float zBtm, float top, float btm) => ok and not na(zTop) and not na(zBtm) and math.max(zBtm, btm) <= math.min(zTop, top)

f_overlaps(array<OB> arr, float top, float btm) =>
    bool hit = false
    if array.size(arr) > 0
        for o in arr
            if math.max(o.btm, btm) <= math.min(o.top, top)
                hit := true
    hit

// Celda de acierto: % (color por nivel) y número de toques resueltos
f_rateCell(table t, int c, int r, int w, int lo) =>
    int    res  = w + lo
    float  rate = res > 0 ? 100.0 * w / res : na
    color  pc   = res == 0 ? C_SUB : rate >= 60 ? C_GOOD : rate >= 45 ? C_MID : C_BAD
    string txt  = res > 0 ? str.tostring(rate, "0") + "%  ·  " + str.tostring(res) : "—"
    table.cell(t, c, r, txt, text_color = pc, text_size = size.small)

// Fila de la tabla: nombre + acierto con la medida ATR y con la medida R
f_statRow(table t, int r, string name, int w, int lo, int wR, int loR) =>
    table.cell(t, 0, r, name, text_color = C_TEXT, text_size = size.small, text_halign = text.align_left)
    f_rateCell(t, 1, r, w, lo)
    f_rateCell(t, 2, r, wR, loR)

// ═════════════════════════════ 1 · ZONAS BUY / SELL (datos) ════════════════
// Se calculan antes que los OB para poder detectar la confluencia (OB A+)
int  chartSec = timeframe.in_seconds()
bool tf1Val   = tf1On and timeframe.in_seconds(tf1) >= chartSec
bool tf2Val   = tf2On and timeframe.in_seconds(tf2) >= chartSec
bool tf3Val   = tf3On and timeframe.in_seconds(tf3) >= chartSec
bool tf4Val   = tf4On and timeframe.in_seconds(tf4) >= chartSec
bool tf1Ok    = znShow and tf1Val
bool tf2Ok    = znShow and tf2Val
bool tf3Ok    = znShow and tf3Val
bool tf4Ok    = znShow and tf4Val
bool znWick   = znMitig == MIT_WICK

[z1BearTop, z1BearBtm, z1BearT, z1BullTop, z1BullBtm, z1BullT] = request.security(syminfo.tickerid, tf1, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)
[z2BearTop, z2BearBtm, z2BearT, z2BullTop, z2BullBtm, z2BullT] = request.security(syminfo.tickerid, tf2, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)
[z3BearTop, z3BearBtm, z3BearT, z3BullTop, z3BullBtm, z3BullT] = request.security(syminfo.tickerid, tf3, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)
[z4BearTop, z4BearBtm, z4BearT, z4BullTop, z4BullBtm, z4BullT] = request.security(syminfo.tickerid, tf4, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)

// ═════════════════════════════ 2 · ORDER BLOCKS SWING ══════════════════════
[obTrend, obUp, obDn, obShift, obIdx, obLvl] = f_structure(obSwingLen)
[bigTrend, bigUp, bigDn, bigShift, bigIdx, bigLvl] = f_structure(obBigLen)

var array<OB>    bullOBs  = array.new<OB>()
var array<OB>    bearOBs  = array.new<OB>()
var int          obWins   = 0
var int          obLosses = 0
var int          obWinsA  = 0
var int          obLossA  = 0
var int          obWinsR  = 0
var int          obLossR  = 0
var int          obWinsAR = 0
var int          obLossAR = 0
var array<float> bufH     = array.new<float>()
var array<float> bufL     = array.new<float>()
var array<float> bufV     = array.new<float>()
array.push(bufH, high)
array.push(bufL, low)
array.push(bufV, nz(volume))
if array.size(bufH) > BUF
    array.shift(bufH)
    array.shift(bufL)
    array.shift(bufV)

// 1) Salidas, toques, reacciones y mitigaciones (antes de crear los de esta vela)
[bWins, bLosses, bWinsA, bLossA, bWinsR, bLossR, bWinsAR, bLossAR, bFirstTouch, bFirstA] = f_manageOBs(bullOBs, obMitig, obDelMitig)
[sWins, sLosses, sWinsA, sLossA, sWinsR, sLossR, sWinsAR, sLossAR, sFirstTouch, sFirstA] = f_manageOBs(bearOBs, obMitig, obDelMitig)
obWins   += bWins + sWins
obLosses += bLosses + sLosses
obWinsA  += bWinsA + sWinsA
obLossA  += bLossA + sLossA
obWinsR  += bWinsR + sWinsR
obLossR  += bLossR + sLossR
obWinsAR += bWinsAR + sWinsAR
obLossAR += bLossAR + sLossAR

// 2) Nuevo OB en cada ruptura swing, solo si pasa los filtros
bool newBullOB = false
bool newBearOB = false
bool newAplus  = false
if obShow and (obUp or obDn)
    [oTop, oBtm, oOff] = f_obCandle(bufH, bufL, obUp, obIdx)
    [oPass, oStars]    = f_obQuality(bufV, obUp, oOff, oTop, oBtm, obShift, bigTrend)
    array<OB> target   = obUp ? bullOBs : bearOBs
    if oPass and not f_overlaps(target, oTop, oBtm)
        // A+: el OB está dentro de una zona BUY (alcista) o SELL (bajista) de TF superior
        bool   confBuy  = f_ov(tf1Val, z1BullTop, z1BullBtm, oTop, oBtm) or f_ov(tf2Val, z2BullTop, z2BullBtm, oTop, oBtm) or f_ov(tf3Val, z3BullTop, z3BullBtm, oTop, oBtm) or f_ov(tf4Val, z4BullTop, z4BullBtm, oTop, oBtm)
        bool   confSell = f_ov(tf1Val, z1BearTop, z1BearBtm, oTop, oBtm) or f_ov(tf2Val, z2BearTop, z2BearBtm, oTop, oBtm) or f_ov(tf3Val, z3BearTop, z3BearBtm, oTop, oBtm) or f_ov(tf4Val, z4BearTop, z4BearBtm, oTop, oBtm)
        bool   aplus    = obAplusOn and (obUp ? confBuy : confSell)
        color  c        = obUp ? buyCol : sellCol
        string txt      = obTextOn ? (aplus ? "A+ " : "OB ") + str.repeat("★", oStars) : ""
        float  midP     = (oTop + oBtm) / 2
        box    bx       = box.new(bar_index - oOff, oTop, bar_index, oBtm, border_color = aplus ? aplusCol : color.new(c, 55), border_width = aplus ? 2 : 1, bgcolor = color.new(c, obTransp), text = txt, text_color = aplus ? aplusCol : c, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_top)
        line   md       = obMidOn ? line.new(bar_index - oOff, midP, bar_index, midP, color = color.new(c, 40), style = f_lineStyle(obMidStyle)) : na
        array.unshift(target, OB.new(bx = bx, mid = md, top = oTop, btm = oBtm, dir = obUp ? 1 : -1, atrRef = atr, aplus = aplus))
        if array.size(target) > obMaxActive
            array.pop(target)
        newBullOB := obUp
        newBearOB := obDn
        newAplus  := aplus

// ═════════════════════════════ 1 · ZONAS BUY / SELL (medición y dibujo) ════
// Medición de la reacción de cada zona visible (8 = 4 temporalidades × 2 lados)
[w1s, l1s, r1s, q1s, f1s, x1s] = f_trackZone(z1BearTop, z1BearBtm, z1BearT, false, tf1Ok and znSellOn)
[w1b, l1b, r1b, q1b, f1b, x1b] = f_trackZone(z1BullTop, z1BullBtm, z1BullT, true, tf1Ok and znBuyOn)
[w2s, l2s, r2s, q2s, f2s, x2s] = f_trackZone(z2BearTop, z2BearBtm, z2BearT, false, tf2Ok and znSellOn)
[w2b, l2b, r2b, q2b, f2b, x2b] = f_trackZone(z2BullTop, z2BullBtm, z2BullT, true, tf2Ok and znBuyOn)
[w3s, l3s, r3s, q3s, f3s, x3s] = f_trackZone(z3BearTop, z3BearBtm, z3BearT, false, tf3Ok and znSellOn)
[w3b, l3b, r3b, q3b, f3b, x3b] = f_trackZone(z3BullTop, z3BullBtm, z3BullT, true, tf3Ok and znBuyOn)
[w4s, l4s, r4s, q4s, f4s, x4s] = f_trackZone(z4BearTop, z4BearBtm, z4BearT, false, tf4Ok and znSellOn)
[w4b, l4b, r4b, q4b, f4b, x4b] = f_trackZone(z4BullTop, z4BullBtm, z4BullT, true, tf4Ok and znBuyOn)

// Acumulados por lado (BUY / SELL) y por medida (ATR / R)
var int znWinB  = 0
var int znLossB = 0
var int znWinS  = 0
var int znLossS = 0
var int znWinBR  = 0
var int znLossBR = 0
var int znWinSR  = 0
var int znLossSR = 0
znWinB   += w1b + w2b + w3b + w4b
znLossB  += l1b + l2b + l3b + l4b
znWinS   += w1s + w2s + w3s + w4s
znLossS  += l1s + l2s + l3s + l4s
znWinBR  += r1b + r2b + r3b + r4b
znLossBR += q1b + q2b + q3b + q4b
znWinSR  += r1s + r2s + r3s + r4s
znLossSR += q1s + q2s + q3s + q4s
bool zoneSellTouch = f1s or f2s or f3s or f4s
bool zoneBuyTouch  = f1b or f2b or f3b or f4b

// Dibujo en la última vela (solo las zonas que el gráfico no ha invalidado)
var array<box>   znBoxes  = array.new<box>()
var array<line>  znLines  = array.new<line>()
var array<label> znLabels = array.new<label>()
if znShow and barstate.islast
    for b in znBoxes
        box.delete(b)
    for l in znLines
        line.delete(l)
    for lb in znLabels
        label.delete(lb)
    array.clear(znBoxes)
    array.clear(znLines)
    array.clear(znLabels)
    f_zone(znBoxes, znLines, znLabels, tf1Ok and znSellOn and not x1s, z1BearTop, z1BearBtm, z1BearT, "▼ " + f_tfLabel(tf1) + " SELL", sellCol, false)
    f_zone(znBoxes, znLines, znLabels, tf1Ok and znBuyOn and not x1b, z1BullTop, z1BullBtm, z1BullT, "▲ " + f_tfLabel(tf1) + " BUY", buyCol, true)
    f_zone(znBoxes, znLines, znLabels, tf2Ok and znSellOn and not x2s, z2BearTop, z2BearBtm, z2BearT, "▼ " + f_tfLabel(tf2) + " SELL", sellCol, false)
    f_zone(znBoxes, znLines, znLabels, tf2Ok and znBuyOn and not x2b, z2BullTop, z2BullBtm, z2BullT, "▲ " + f_tfLabel(tf2) + " BUY", buyCol, true)
    f_zone(znBoxes, znLines, znLabels, tf3Ok and znSellOn and not x3s, z3BearTop, z3BearBtm, z3BearT, "▼ " + f_tfLabel(tf3) + " SELL", sellCol, false)
    f_zone(znBoxes, znLines, znLabels, tf3Ok and znBuyOn and not x3b, z3BullTop, z3BullBtm, z3BullT, "▲ " + f_tfLabel(tf3) + " BUY", buyCol, true)
    f_zone(znBoxes, znLines, znLabels, tf4Ok and znSellOn and not x4s, z4BearTop, z4BearBtm, z4BearT, "▼ " + f_tfLabel(tf4) + " SELL", sellCol, false)
    f_zone(znBoxes, znLines, znLabels, tf4Ok and znBuyOn and not x4b, z4BullTop, z4BullBtm, z4BullT, "▲ " + f_tfLabel(tf4) + " BUY", buyCol, true)

// ═════════════════════════════ TABLA DE REACCIÓN ═══════════════════════════
var table stTbl = table.new(f_pos(statsPos), 3, 7, bgcolor = C_CARD, frame_color = C_GRID, frame_width = 1, border_color = C_GRID, border_width = 1)
if statsOn and barstate.isfirst
    table.merge_cells(stTbl, 0, 0, 2, 0)
    table.merge_cells(stTbl, 0, 6, 2, 6)
if statsOn and barstate.islast and (obShow or znShow)
    table.cell(stTbl, 0, 0, "CH Zone Signals  ·  by Sanchez  ·  " + timeframe.period, text_color = C_TEXT, bgcolor = C_HEAD, text_size = size.small, text_halign = text.align_center)
    table.cell(stTbl, 0, 1, "Reacción", text_color = C_SUB, bgcolor = C_HEAD, text_size = size.tiny, text_halign = text.align_left)
    table.cell(stTbl, 1, 1, "≥ " + str.tostring(reactAtr) + " ATR", text_color = C_SUB, bgcolor = C_HEAD, text_size = size.tiny)
    table.cell(stTbl, 2, 1, "≥ " + str.tostring(reactR) + " R", text_color = C_SUB, bgcolor = C_HEAD, text_size = size.tiny)
    f_statRow(stTbl, 2, "▲ Zonas BUY", znWinB, znLossB, znWinBR, znLossBR)
    f_statRow(stTbl, 3, "▼ Zonas SELL", znWinS, znLossS, znWinSR, znLossSR)
    f_statRow(stTbl, 4, "OB swing", obWins, obLosses, obWinsR, obLossR)
    f_statRow(stTbl, 5, "OB A+", obWinsA, obLossA, obWinsAR, obLossAR)
    table.cell(stTbl, 0, 6, "% acierto · toques resueltos   (menos de 30 = poca muestra)", text_color = C_SUB, text_size = size.tiny, text_halign = text.align_left)

// ═════════════════════════════ ALERTAS ═════════════════════════════════════
alertcondition(zoneBuyTouch, "Precio toca zona BUY", "CH Zones: {{ticker}} vuelve a una zona BUY ({{close}})")
alertcondition(zoneSellTouch, "Precio toca zona SELL", "CH Zones: {{ticker}} vuelve a una zona SELL ({{close}})")
alertcondition(newBullOB, "Nuevo OB swing alcista", "CH Zones: nuevo OB swing alcista en {{ticker}} ({{interval}})")
alertcondition(newBearOB, "Nuevo OB swing bajista", "CH Zones: nuevo OB swing bajista en {{ticker}} ({{interval}})")
alertcondition(newAplus, "Nuevo OB A+ (en zona de TF superior)", "CH Zones: nuevo OB A+ en {{ticker}} ({{interval}}), dentro de una zona de temporalidad superior")
alertcondition(bFirstTouch, "Precio toca OB alcista", "CH Zones: {{ticker}} vuelve a un OB swing alcista ({{close}})")
alertcondition(sFirstTouch, "Precio toca OB bajista", "CH Zones: {{ticker}} vuelve a un OB swing bajista ({{close}})")
alertcondition(bFirstA or sFirstA, "Precio toca OB A+", "CH Zones: {{ticker}} vuelve a un OB A+ ({{close}})")
