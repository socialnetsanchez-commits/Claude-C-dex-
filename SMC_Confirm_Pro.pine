//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  SMC Confirm Pro · Pine Script v6
//  Estilo smart money con confirmaciones antes de cada entrada:
//   · Sesiones Tokio / Londres / Nueva York (cajas con su nombre debajo)
//   · Estructura BOS / CHoCH: swing (línea continua) e interna (discontinua)
//   · Order blocks que se extienden hasta ser mitigados
//   · Zonas de oferta / demanda multi-temporalidad ("M15 SELL", "M30 BUY"...)
//   · Perfil de volumen diario con POC y POC de días anteriores
//   · Máximo / mínimo fuerte y débil (liquidez)
//   · Señal = zona tocada + CHoCH/BOS interno a favor + puntuación mínima
//   · Gestión: stop tras la zona, TP1-TP3 en R, breakeven y estadísticas en R
//  Sin repintado: zonas MTF con [1] + lookahead_on y señales al cierre de vela.
//  No es asesoramiento financiero. Valida fuera de muestra antes de operar.
// ════════════════════════════════════════════════════════════════════════════
indicator("SMC Confirm Pro", shorttitle = "SMC Pro", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ─────────────────────────────── Constantes ────────────────────────────────
const string G_SES  = "1 · Sesiones"
const string G_STR  = "2 · Estructura (BOS / CHoCH)"
const string G_OB   = "3 · Order blocks"
const string G_MTF  = "4 · Zonas multi-temporalidad"
const string G_VP   = "5 · Perfil de volumen"
const string G_SIG  = "6 · Señales con confirmación"
const string G_RISK = "7 · Gestión de riesgo"
const string G_UI   = "8 · Colores y panel"
const float  EPS    = 0.000001

// ═══════════════════════════════ INPUTS ════════════════════════════════════
// 1 · Sesiones (cada una con su zona horaria: el horario de verano se ajusta solo)
bool   showSessions = input.bool(true, "Mostrar sesiones", group = G_SES)
