int    vpLookback  = input.int(300, "N velas", minval = 20, maxval = 5000, group = G_VP, inline = "anc")
int    vpPastDays  = input.int(4, "Perfiles de periodos anteriores", minval = 0, maxval = 8, group = G_VP, inline = "past", tooltip = "Cada periodo terminado deja dibujado su perfil completo (compradores, vendedores, POC, VAH y VAL). TradingView limita las cajas a 500, por eso el máximo es 8.")
bool   vpPastText  = input.bool(false, "con texto", group = G_VP, inline = "past")
