bool   ifNeedEma   = input.bool(true, "Solo a favor de la EMA 200", group = G_IF)
bool   ifNeedBig   = input.bool(true, "Solo a favor de la estructura mayor", group = G_IF)
float  ifMaxAtr    = input.float(3.0, "Altura máxima (ATR ×)", minval = 0.2, step = 0.1, group = G_IF)
