// 3 · Order blocks swing fuertes
bool   obShow      = input.bool(true, "Mostrar order blocks swing", group = G_OB)
int    obSwingLen  = input.int(25, "Longitud de swing", minval = 5, maxval = 200, group = G_OB)
bool   obNeedDisp  = input.bool(true, "Desplazamiento ≥ ATR ×", group = G_OB, inline = "od", tooltip = "Tras el OB, el precio debe alejarse al menos X ATR en las N velas siguientes (salida rápida). Súbelo a 1,5 para OB todavía más selectivos.")
float  obDispAtr   = input.float(1.0, "", minval = 0.25, step = 0.25, group = G_OB, inline = "od")
int    obDispBars  = input.int(3, "en velas", minval = 1, maxval = 10, group = G_OB, inline = "od")
bool   obNeedFvg   = input.bool(true, "Deja un FVG en esas velas", group = G_OB)
bool   obNeedSweep = input.bool(false, "El OB barre liquidez previa", group = G_OB, inline = "osw")
int    obSweepLook = input.int(20, "velas", minval = 3, maxval = 100, group = G_OB, inline = "osw")
