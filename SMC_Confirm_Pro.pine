string znMidStyle = input.string(ST_DASHED, "", options = [ST_SOLID, ST_DASHED, ST_DOTTED], group = G_ZN, inline = "zm")
color  znTxtCol   = input.color(#787b86, "Texto", group = G_ZN, inline = "zt")
