int    vpLookback  = input.int(300, "N velas", minval = 20, maxval = 5000, group = G_VP, inline = "anc")
int    vpRows      = input.int(50, "Filas (resolución)", minval = 10, maxval = 150, group = G_VP)
int    vpWidth     = input.int(50, "Ancho máximo (barras)", minval = 5, maxval = 300, group = G_VP)
string vpPlace     = input.string(VP_AT_START, "Posición", options = [VP_AT_START, VP_AT_RIGHT], group = G_VP, inline = "pos")
int    vpOffset    = input.int(10, "separación (barras)", minval = 0, maxval = 100, group = G_VP, inline = "pos")
string vpMode      = input.string(VP_SPLIT, "Modo", options = [VP_SPLIT, VP_TOTAL], group = G_VP)
float  vpGap       = input.float(15, "Separación entre filas (%)", minval = 0, maxval = 80, step = 5, group = G_VP)
