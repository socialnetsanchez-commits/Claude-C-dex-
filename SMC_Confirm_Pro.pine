float  obMaxAtr    = input.float(3.0, "Altura máxima del OB (ATR ×)", minval = 0.2, step = 0.1, group = G_OB)
int    obMaxActive = input.int(4, "Máx. activos por lado", minval = 1, maxval = 20, group = G_OB)
string obMitig     = input.string(MIT_CLOSE, "Mitigación", options = [MIT_CLOSE, MIT_WICK], group = G_OB, inline = "om")
bool   obDelMitig  = input.bool(false, "borrar mitigados", group = G_OB, inline = "om")
color  obBullCol   = input.color(color.new(#089981, 60), "Alcista", group = G_OB, inline = "oc")
color  obBearCol   = input.color(color.new(#f23645, 70), "Bajista", group = G_OB, inline = "oc")
bool   obTextOn    = input.bool(true, "Texto con fuerza (★)", group = G_OB, inline = "ot")
color  obTxtCol    = input.color(#787b86, "", group = G_OB, inline = "ot")
bool   obStatsOn   = input.bool(true, "Medir reacción", group = G_OB, inline = "os", tooltip = "Cuenta cuántos OB, tras el primer toque, se alejan al menos X ATR antes de ser mitigados. Si en la misma vela ocurren reacción y mitigación, cuenta como fallo.")
float  obReactAtr  = input.float(1.5, "≥ ATR ×", minval = 0.25, step = 0.25, group = G_OB, inline = "os")
string obStatsPos  = input.string(POS_BR, "Tabla", options = [POS_TR, POS_TL, POS_BR, POS_BL], group = G_OB, inline = "os")

// 4 · SMT
bool   smtShow    = input.bool(true, "Mostrar SMT", group = G_SMT)
string smtMode    = input.string(SMT_AUTO, "Activo de comparación", options = [SMT_AUTO, SMT_MANUAL], group = G_SMT, inline = "sm", tooltip = "Automático: NQ↔ES, YM/RTY→ES, GC↔SI, XAUUSD↔XAGUSD, EURUSD↔GBPUSD, NAS100/US30→SPX500. Si el activo no se reconoce, usa el símbolo manual.")
string smtSym     = input.symbol("CME_MINI:ES1!", "", group = G_SMT, inline = "sm")
bool   smtInvert  = input.bool(false, "Correlación inversa (p. ej. EURUSD frente a DXY)", group = G_SMT)
int    smtLen     = input.int(5, "Longitud de pivote", minval = 2, maxval = 50, group = G_SMT)
int    smtMaxGap  = input.int(80, "Máx. velas entre los dos pivotes", minval = 5, maxval = 400, group = G_SMT)
color  smtBearCol = input.color(#f23645, "Bajista", group = G_SMT, inline = "smc")
color  smtBullCol = input.color(#089981, "Alcista", group = G_SMT, inline = "smc")
string smtStyle   = input.string(ST_SOLID, "Línea", options = [ST_SOLID, ST_DASHED, ST_DOTTED], group = G_SMT, inline = "sml")
int    smtWidth   = input.int(2, "grosor", minval = 1, maxval = 5, group = G_SMT, inline = "sml")
int    confWin    = input.int(20, "Ventana de la alerta de confluencia (velas)", minval = 1, maxval = 200, group = G_SMT, tooltip = "Alerta 'Confluencia': precio en zona SELL u OB bajista + SMT bajista + MSS bajista dentro de esta ventana (y al revés para compras).")

// 5 · MSS
bool   mssSwOn     = input.bool(true, "MSS swing", group = G_MSS, inline = "m1")
int    mssSwLen    = input.int(25, "longitud", minval = 5, maxval = 200, group = G_MSS, inline = "m1")
bool   mssInOn     = input.bool(true, "MSS interno", group = G_MSS, inline = "m2")
int    mssInLen    = input.int(5, "longitud", minval = 2, maxval = 50, group = G_MSS, inline = "m2")
bool   mssNeedDisp = input.bool(false, "Solo con desplazamiento: cuerpo ≥ ATR ×", group = G_MSS, inline = "m3")
float  mssDispAtr  = input.float(1.0, "", minval = 0.1, step = 0.1, group = G_MSS, inline = "m3")
string mssLabel    = input.string(LB_FILLED, "Etiqueta", options = [LB_FILLED, LB_TEXT], group = G_MSS)
color  mssBullCol  = input.color(#089981, "Alcista", group = G_MSS, inline = "mc")
color  mssBearCol  = input.color(#f23645, "Bajista", group = G_MSS, inline = "mc")
int    mssSwWidth  = input.int(2, "Grosor de la línea swing", minval = 1, maxval = 5, group = G_MSS)

// ═════════════════════════════ CÁLCULOS BASE ═══════════════════════════════
const int BUF   = 400    // velas guardadas para localizar order blocks
float atr       = ta.atr(14)
float volAvg    = ta.sma(volume, 20)
bool  hasVolume = ta.cum(nz(volume)) > 0
color C_NONE    = color.new(#000000, 100)

// ═════════════════════════════ TIPOS ═══════════════════════════════════════
type OB
    box   bx
    float top
    float btm
    int   dir
    float atrRef
    bool  touched  = false
    int   touchBar = na
    bool  resolved = false

type PocLine
    line  ln
    float price
    bool  naked = true

// ═════════════════════════════ FUNCIONES ═══════════════════════════════════
f_lineStyle(string s) => s == ST_SOLID ? line.style_solid : s == ST_DASHED ? line.style_dashed : line.style_dotted

f_size(string s) => s == SZ_TINY ? size.tiny : s == SZ_SMALL ? size.small : size.normal

f_pos(string s) => s == POS_TR ? position.top_right : s == POS_TL ? position.top_left : s == POS_BR ? position.bottom_right : position.bottom_left

// Estructura de mercado. Un pivote máximo se confirma cuando el máximo de hace
// `len` velas supera a todas las posteriores (igual para mínimos).
// shift = true cuando la ruptura va contra la tendencia previa (MSS).
f_structure(int len) =>
    var int   leg     = 0
    var float topLvl  = na
    var int   topIdx  = na
    var bool  topOpen = false
    var float btmLvl  = na
    var int   btmIdx  = na
    var bool  btmOpen = false
    var int   trend   = 0
    float hh      = ta.highest(high, len)
    float ll      = ta.lowest(low, len)
    int   prevLeg = leg
    if high[len] > hh
        leg := 0
    else if low[len] < ll
        leg := 1
    if leg == 0 and prevLeg == 1
        topLvl  := high[len]
        topIdx  := bar_index - len
        topOpen := true
    if leg == 1 and prevLeg == 0
        btmLvl  := low[len]
        btmIdx  := bar_index - len
        btmOpen := true
    bool  brkUp  = topOpen and close > topLvl
    bool  brkDn  = not brkUp and btmOpen and close < btmLvl
    bool  shift  = false
    int   brkIdx = na
    float brkLvl = na
    if brkUp
        shift   := trend == -1
        trend   := 1
        topOpen := false
        brkIdx  := topIdx
        brkLvl  := topLvl
    else if brkDn
        shift   := trend == 1
        trend   := -1
        btmOpen := false
        brkIdx  := btmIdx
        brkLvl  := btmLvl
    [trend, brkUp, brkDn, shift, brkIdx, brkLvl]

// Valor de hace `i` velas guardado en un buffer (0 = vela actual).
// Los buffers evitan leer el historial con [] dentro de llamadas condicionales.
f_at(array<float> a, int i) => array.get(a, array.size(a) - 1 - i)

// Vela de origen del impulso: mínimo más bajo (alcista) o máximo más alto
// (bajista) entre el pivote roto y la vela actual. Devuelve [máximo, mínimo, desfase].
f_obCandle(array<float> hs, array<float> ls, bool bullish, int fromIdx) =>
    int   span = math.max(0, math.min(bar_index - fromIdx, array.size(hs) - 1))
    float ext  = bullish ? f_at(ls, 0) : f_at(hs, 0)
    int   off  = 0
    for i = 0 to span
        float v = bullish ? f_at(ls, i) : f_at(hs, i)
        if (bullish and v < ext) or (not bullish and v > ext)
            ext := v
            off := i
    [f_at(hs, off), f_at(ls, off), off]

// Calidad del order block: desplazamiento, FVG, barrido de liquidez, volumen y altura
f_obQuality(array<float> hs, array<float> ls, array<float> vs, bool bullish, int off, float top, float btm) =>
    // Desplazamiento y FVG deben aparecer justo después del OB (salida rápida)
    int  nAfter = math.min(obDispBars, off)
    bool dispOk = false
    bool fvgOk  = false
    if nAfter >= 1
        float far = bullish ? top : btm
        for k = 1 to nAfter
            far := bullish ? math.max(far, f_at(hs, off - k)) : math.min(far, f_at(ls, off - k))
        dispOk := (bullish ? far - top : btm - far) >= obDispAtr * atr
        int jStart = math.max(0, off - nAfter - 1)
        if off - 2 >= jStart
            for j = jStart to off - 2
                if bullish ? f_at(ls, j) > f_at(hs, j + 2) : f_at(hs, j) < f_at(ls, j + 2)
                    fvgOk := true
                    break
    bool sweepOk = false
    int  kEnd    = math.min(off + obSweepLook, array.size(hs) - 1)
    if kEnd >= off + 1
        float prior = bullish ? f_at(ls, off + 1) : f_at(hs, off + 1)
        for k = off + 1 to kEnd
            prior := bullish ? math.min(prior, f_at(ls, k)) : math.max(prior, f_at(hs, k))
        sweepOk := bullish ? btm < prior : top > prior
    float vSum = 0.0
    for i = off - nAfter to off
        vSum += f_at(vs, i)
    bool  volOk  = not hasVolume or vSum / (nAfter + 1) > volAvg
    bool  sizeOk = top - btm <= obMaxAtr * atr
    bool  pass   = sizeOk and (not obNeedDisp or dispOk) and (not obNeedFvg or fvgOk) and (not obNeedSweep or sweepOk) and (not obNeedVol or volOk)
    int   stars  = (dispOk ? 1 : 0) + (fvgOk ? 1 : 0) + (sweepOk ? 1 : 0) + (volOk and hasVolume ? 1 : 0)
    [pass, stars]

// Zonas de oferta / demanda de otra temporalidad (se evalúa con request.security).
// Devuelve la última zona sin mitigar de cada lado usando solo velas cerradas.
f_mtfZones(int len, bool wickMitig) =>
    var array<float> hs = array.new<float>()
    var array<float> ls = array.new<float>()
    var array<int>   ts = array.new<int>()
    array.push(hs, high)
    array.push(ls, low)
    array.push(ts, time)
    if array.size(hs) > BUF
        array.shift(hs)
        array.shift(ls)
        array.shift(ts)
    [mTrend, mUp, mDn, mShift, mIdx, mLvl] = f_structure(len)
    var float bearTop = na
    var float bearBtm = na
    var int   bearT   = na
    var float bullTop = na
    var float bullBtm = na
    var int   bullT   = na
    if mUp
        [uH, uL, uOff] = f_obCandle(hs, ls, true, mIdx)
        bullTop := uH
        bullBtm := uL
        bullT   := array.get(ts, array.size(ts) - 1 - uOff)
    if mDn
        [dH, dL, dOff] = f_obCandle(hs, ls, false, mIdx)
        bearTop := dH
        bearBtm := dL
        bearT   := array.get(ts, array.size(ts) - 1 - dOff)
    float upSrc = wickMitig ? high : close
    float dnSrc = wickMitig ? low : close
    if not na(bullBtm) and dnSrc < bullBtm
        bullTop := na
        bullBtm := na
        bullT   := na
    if not na(bearTop) and upSrc > bearTop
        bearTop := na
        bearBtm := na
        bearT   := na
    [bearTop[1], bearBtm[1], bearT[1], bullTop[1], bullBtm[1], bullT[1]]

f_tfLabel(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(int(s / 60)) : s < 86400 ? "H" + str.tostring(int(s / 3600)) : s < 604800 ? "D" + str.tostring(int(s / 86400)) : "W" + str.tostring(int(s / 604800))

f_tap(bool ok, float top, float btm) => ok and not na(top) and not na(btm) and high >= btm and low <= top

// Dibuja una zona MTF (caja + texto + línea media) en la última vela
f_zone(array<box> bxs, array<line> lns, bool ok, float top, float btm, int t, string txt, color c) =>
    if ok and not na(top) and not na(btm) and not na(t)
        int rightT = time + znExt * timeframe.in_seconds() * 1000
        array.push(bxs, box.new(t, top, rightT, btm, xloc = xloc.bar_time, border_color = color.new(c, 40), bgcolor = color.new(c, znTransp), text = txt, text_color = znTxtCol, text_size = f_size(znTxtSize), text_halign = text.align_center, text_valign = text.align_center))
        if znMidOn
            float mid = (top + btm) / 2
            array.push(lns, line.new(t, mid, rightT, mid, xloc = xloc.bar_time, color = color.new(c, 30), style = f_lineStyle(znMidStyle)))
    true

// MSS bien marcado: línea desde el pivote roto hasta la ruptura + etiqueta
f_drawMSS(bool up, int fromIdx, float lvl, bool isSwing) =>
    color c      = up ? mssBullCol : mssBearCol
    bool  filled = mssLabel == LB_FILLED
    line.new(fromIdx, lvl, bar_index, lvl, color = c, style = isSwing ? line.style_solid : line.style_dashed, width = isSwing ? mssSwWidth : 1)
    label.new(fromIdx + int((bar_index - fromIdx) / 2), lvl, "MSS", style = up ? label.style_label_down : label.style_label_up, color = filled ? c : C_NONE, textcolor = filled ? color.white : c, size = isSwing ? size.small : size.tiny)
    true

// SMT: línea entre los dos pivotes del gráfico + etiqueta
f_drawSMT(int x1, float y1, int x2, float y2, bool bullish, string tip) =>
    color c = bullish ? smtBullCol : smtBearCol
    line.new(x1, y1, x2, y2, color = c, style = f_lineStyle(smtStyle), width = smtWidth)
    label.new(x2, y2, "SMT", style = bullish ? label.style_label_up : label.style_label_down, color = C_NONE, textcolor = c, size = size.small, tooltip = tip)
    true

// Activo correlacionado por defecto según el gráfico
f_smtAuto(string fallback) =>
    string r = syminfo.root
    string t = syminfo.ticker
    string s = fallback
    if r == "NQ" or r == "MNQ"
        s := "CME_MINI:ES1!"
    else if r == "ES" or r == "MES"
        s := "CME_MINI:NQ1!"
    else if r == "YM" or r == "MYM" or r == "RTY" or r == "M2K"
        s := "CME_MINI:ES1!"
    else if r == "GC" or r == "MGC"
        s := "COMEX:SI1!"
    else if r == "SI" or r == "SIL"
        s := "COMEX:GC1!"
    else if str.contains(t, "XAU")
        s := "OANDA:XAGUSD"
    else if str.contains(t, "XAG")
        s := "OANDA:XAUUSD"
    else if t == "EURUSD"
        s := "OANDA:GBPUSD"
    else if t == "GBPUSD"
        s := "OANDA:EURUSD"
    else if str.contains(t, "NAS100") or str.contains(t, "US100") or str.contains(t, "USTEC") or str.contains(t, "US30")
        s := "OANDA:SPX500USD"
    s

// Gestiona los OB activos: toque, reacción, mitigación y extensión de la caja
f_manageOBs(array<OB> arr) =>
    int  wins   = 0
    int  losses = 0
    bool firstT = false
    bool inside = false
    int  n      = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            OB    o      = array.get(arr, i)
            bool  bull   = o.dir == 1
            float srcM   = obMitig == MIT_CLOSE ? close : bull ? low : high
            bool  inZone = high >= o.btm and low <= o.top
            bool  mitig  = bull ? srcM < o.btm : srcM > o.top
            if not o.touched and inZone
                o.touched  := true
                o.touchBar := bar_index
                firstT     := true
            if mitig
                // Supuesto conservador: mitigación antes que reacción en la misma vela
                if o.touched and not o.resolved
                    o.resolved := true
                    losses     += 1
                box.set_right(o.bx, bar_index)
                if obDelMitig
                    box.delete(o.bx)
                array.remove(arr, i)
            else
                if inZone
                    inside := true
                if o.touched and not o.resolved and bar_index > o.touchBar
                    bool reacted = bull ? high >= o.top + obReactAtr * o.atrRef : low <= o.btm - obReactAtr * o.atrRef
                    if reacted
                        o.resolved := true
                        wins       += 1
                box.set_right(o.bx, bar_index)
    [wins, losses, firstT, inside]

f_overlaps(array<OB> arr, float top, float btm) =>
    bool hit = false
    if array.size(arr) > 0
        for o in arr
            if math.max(o.btm, btm) <= math.min(o.top, top)
                hit := true
    hit

// Perfil: reparte el volumen de cada vela entre las filas de precio que cubre
f_profile(array<float> hs, array<float> ls, array<float> vs, array<bool> ups, int rows) =>
    float top   = array.max(hs)
    float btm   = array.min(ls)
    float step  = (top - btm) / rows
    array<float> buyV  = array.new<float>(rows, 0.0)
    array<float> sellV = array.new<float>(rows, 0.0)
    if step > 0
        for i = 0 to array.size(hs) - 1
            float h   = array.get(hs, i)
            float l   = array.get(ls, i)
            float v   = array.get(vs, i)
            bool  up  = array.get(ups, i)
            int   r0  = math.max(0, math.min(rows - 1, int(math.floor((l - btm) / step))))
            int   r1  = math.max(0, math.min(rows - 1, int(math.floor((h - btm) / step))))
            float rng = h - l
            for r = r0 to r1
                float rowLo = btm + r * step
                float share = rng > 0 ? math.max(math.min(h, rowLo + step) - math.max(l, rowLo), 0) / rng : 1.0 / (r1 - r0 + 1)
                if up
                    array.set(buyV, r, array.get(buyV, r) + v * share)
                else
                    array.set(sellV, r, array.get(sellV, r) + v * share)
    [btm, step, buyV, sellV]

f_pocRow(array<float> buyV, array<float> sellV) =>
    float maxV = 0.0
    int   row  = -1
    for r = 0 to array.size(buyV) - 1
        float t = array.get(buyV, r) + array.get(sellV, r)
        if t > maxV
            maxV := t
            row  := r
    [row, maxV]

// Value area: crece desde el POC hacia la fila vecina con más volumen
f_valueArea(array<float> tot, int pocRow, float pct) =>
    int   n      = array.size(tot)
    float target = array.sum(tot) * pct / 100
    float acc    = array.get(tot, pocRow)
    int   up     = pocRow
    int   dn     = pocRow
    while acc < target and (up < n - 1 or dn > 0)
        float vUp = up < n - 1 ? array.get(tot, up + 1) : -1.0
        float vDn = dn > 0 ? array.get(tot, dn - 1) : -1.0
        if vUp >= vDn
            up  += 1
            acc += vUp
        else
            dn  -= 1
            acc += vDn
    [up, dn]

f_fade(color c, bool keep) => keep ? c : color.new(c, math.min(100, color.t(c) + vaOutTransp))

// ═════════════════════════════ 5 · MSS ═════════════════════════════════════
[swTrend, swUp, swDn, swShift, swIdx, swLvl] = f_structure(mssSwLen)
[inTrend, inUp, inDn, inShift, inIdx, inLvl] = f_structure(mssInLen)

bool mssDispOk = not mssNeedDisp or math.abs(close - open) >= mssDispAtr * atr
bool mssSwUp   = mssSwOn and swShift and swUp and mssDispOk
bool mssSwDn   = mssSwOn and swShift and swDn and mssDispOk
bool mssInUp   = mssInOn and inShift and inUp and mssDispOk and not (mssSwUp and inLvl == swLvl)
bool mssInDn   = mssInOn and inShift and inDn and mssDispOk and not (mssSwDn and inLvl == swLvl)

if mssSwUp or mssSwDn
    f_drawMSS(mssSwUp, swIdx, swLvl, true)
if mssInUp or mssInDn
    f_drawMSS(mssInUp, inIdx, inLvl, false)

// ═════════════════════════════ 3 · ORDER BLOCKS SWING ══════════════════════
[obTrend, obUp, obDn, obShift, obIdx, obLvl] = f_structure(obSwingLen)

var array<OB>    bullOBs  = array.new<OB>()
var array<OB>    bearOBs  = array.new<OB>()
var int          obWins   = 0
var int          obLosses = 0
var array<float> bufH     = array.new<float>()
var array<float> bufL     = array.new<float>()
var array<float> bufV     = array.new<float>()
array.push(bufH, high)
array.push(bufL, low)
array.push(bufV, nz(volume))
if array.size(bufH) > BUF
    array.shift(bufH)
    array.shift(bufL)
    array.shift(bufV)

// 1) Toques, reacciones y mitigaciones (antes de crear los de esta vela)
[bWins, bLosses, bFirstTouch, bInside] = f_manageOBs(bullOBs)
[sWins, sLosses, sFirstTouch, sInside] = f_manageOBs(bearOBs)
obWins   += bWins + sWins
obLosses += bLosses + sLosses

// 2) Nuevo OB en cada ruptura swing, solo si pasa los filtros de calidad
bool newBullOB = false
bool newBearOB = false
if obShow and (obUp or obDn)
    [oTop, oBtm, oOff] = f_obCandle(bufH, bufL, obUp, obIdx)
    [oPass, oStars]    = f_obQuality(bufH, bufL, bufV, obUp, oOff, oTop, oBtm)
    array<OB> target   = obUp ? bullOBs : bearOBs
    if oPass and not f_overlaps(target, oTop, oBtm)
        color  c   = obUp ? obBullCol : obBearCol
        string txt = obTextOn ? "OB " + str.repeat("★", oStars) : ""
        box    bx  = box.new(bar_index - oOff, oTop, bar_index, oBtm, border_color = color.new(c, 30), bgcolor = c, text = txt, text_color = obTxtCol, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
        array.unshift(target, OB.new(bx = bx, top = oTop, btm = oBtm, dir = obUp ? 1 : -1, atrRef = atr))
        if array.size(target) > obMaxActive
            array.pop(target)
        newBullOB := obUp
        newBearOB := obDn

// Tabla con la tasa de reacción medida
var table obTbl = table.new(f_pos(obStatsPos), 2, 4, bgcolor = color.new(#0f172a, 15), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)
if obShow and obStatsOn and barstate.islast
    int    resolved = obWins + obLosses
    string rateTx   = resolved > 0 ? str.tostring(100.0 * obWins / resolved, "0.0") + "%" : "—"
    color  txtC     = color.new(#e2e8f0, 0)
    table.cell(obTbl, 0, 0, "OB swing fuertes", text_color = txtC, text_size = size.small, text_halign = text.align_left)
    table.cell(obTbl, 1, 0, resolved < 30 ? "muestra pequeña" : "", text_color = color.orange, text_size = size.tiny)
    table.cell(obTbl, 0, 1, "Toques resueltos", text_color = txtC, text_size = size.small, text_halign = text.align_left)
    table.cell(obTbl, 1, 1, str.tostring(resolved), text_color = txtC, text_size = size.small)
    table.cell(obTbl, 0, 2, "Reacción ≥ " + str.tostring(obReactAtr) + " ATR", text_color = txtC, text_size = size.small, text_halign = text.align_left)
    table.cell(obTbl, 1, 2, rateTx, text_color = resolved > 0 and obWins >= obLosses ? color.new(#089981, 0) : color.new(#f23645, 0), text_size = size.small)
    table.cell(obTbl, 0, 3, "Mitigados tras el toque", text_color = txtC, text_size = size.small, text_halign = text.align_left)
    table.cell(obTbl, 1, 3, str.tostring(obLosses), text_color = txtC, text_size = size.small)

// ═════════════════════════════ 2 · ZONAS SELL / BUY ════════════════════════
int  chartSec = timeframe.in_seconds()
bool tf1Ok    = znShow and tf1On and timeframe.in_seconds(tf1) >= chartSec
bool tf2Ok    = znShow and tf2On and timeframe.in_seconds(tf2) >= chartSec
bool tf3Ok    = znShow and tf3On and timeframe.in_seconds(tf3) >= chartSec
bool tf4Ok    = znShow and tf4On and timeframe.in_seconds(tf4) >= chartSec
bool znWick   = znMitig == MIT_WICK

[z1BearTop, z1BearBtm, z1BearT, z1BullTop, z1BullBtm, z1BullT] = request.security(syminfo.tickerid, tf1, f_mtfZones(znLen, znWick), lookahead = barmerge.lookahead_on)
[z2BearTop, z2BearBtm, z2BearT, z2BullTop, z2BullBtm, z2BullT] = request.security(syminfo.tickerid, tf2, f_mtfZones(znLen, znWick), lookahead = barmerge.lookahead_on)
[z3BearTop, z3BearBtm, z3BearT, z3BullTop, z3BullBtm, z3BullT] = request.security(syminfo.tickerid, tf3, f_mtfZones(znLen, znWick), lookahead = barmerge.lookahead_on)
[z4BearTop, z4BearBtm, z4BearT, z4BullTop, z4BullBtm, z4BullT] = request.security(syminfo.tickerid, tf4, f_mtfZones(znLen, znWick), lookahead = barmerge.lookahead_on)

bool zoneSellTap = znSellOn and (f_tap(tf1Ok, z1BearTop, z1BearBtm) or f_tap(tf2Ok, z2BearTop, z2BearBtm) or f_tap(tf3Ok, z3BearTop, z3BearBtm) or f_tap(tf4Ok, z4BearTop, z4BearBtm))
bool zoneBuyTap  = znBuyOn and (f_tap(tf1Ok, z1BullTop, z1BullBtm) or f_tap(tf2Ok, z2BullTop, z2BullBtm) or f_tap(tf3Ok, z3BullTop, z3BullBtm) or f_tap(tf4Ok, z4BullTop, z4BullBtm))

var array<box>  znBoxes = array.new<box>()
var array<line> znLines = array.new<line>()
if znShow and barstate.islast
    for b in znBoxes
        box.delete(b)
    for l in znLines
        line.delete(l)
    array.clear(znBoxes)
    array.clear(znLines)
    f_zone(znBoxes, znLines, tf1Ok and znSellOn, z1BearTop, z1BearBtm, z1BearT, f_tfLabel(tf1) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf1Ok and znBuyOn, z1BullTop, z1BullBtm, z1BullT, f_tfLabel(tf1) + " BUY", znBuyCol)
    f_zone(znBoxes, znLines, tf2Ok and znSellOn, z2BearTop, z2BearBtm, z2BearT, f_tfLabel(tf2) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf2Ok and znBuyOn, z2BullTop, z2BullBtm, z2BullT, f_tfLabel(tf2) + " BUY", znBuyCol)
    f_zone(znBoxes, znLines, tf3Ok and znSellOn, z3BearTop, z3BearBtm, z3BearT, f_tfLabel(tf3) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf3Ok and znBuyOn, z3BullTop, z3BullBtm, z3BullT, f_tfLabel(tf3) + " BUY", znBuyCol)
    f_zone(znBoxes, znLines, tf4Ok and znSellOn, z4BearTop, z4BearBtm, z4BearT, f_tfLabel(tf4) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf4Ok and znBuyOn, z4BullTop, z4BullBtm, z4BullT, f_tfLabel(tf4) + " BUY", znBuyCol)

// ═════════════════════════════ 4 · SMT ═════════════════════════════════════
string smtTicker = smtMode == SMT_AUTO ? f_smtAuto(smtSym) : smtSym
[cmpHigh, cmpLow] = request.security(smtTicker, timeframe.period, [high, low], ignore_invalid_symbol = true)
float cH  = smtInvert ? -cmpLow : cmpHigh
float cL  = smtInvert ? -cmpHigh : cmpLow
float pvH = ta.pivothigh(high, smtLen, smtLen)
float pvL = ta.pivotlow(low, smtLen, smtLen)
float cHi = ta.highest(cH, 2 * smtLen + 1)
float cLo = ta.lowest(cL, 2 * smtLen + 1)

var float lastPh    = na
var float lastPhCmp = na
var int   lastPhBar = na
var float lastPl    = na
var float lastPlCmp = na
var int   lastPlBar = na
bool smtBear = false
bool smtBull = false
string smtTip = "Divergencia con " + smtTicker + (smtInvert ? " (correlación inversa)" : "")

// En máximos: uno hace máximo más alto y el otro no → SMT bajista
if not na(pvH)
    int phBar = bar_index - smtLen
    if not na(lastPh) and not na(lastPhCmp) and not na(cHi) and phBar - lastPhBar <= smtMaxGap
        smtBear := smtShow and ((pvH > lastPh and cHi < lastPhCmp) or (pvH < lastPh and cHi > lastPhCmp))
        if smtBear
            f_drawSMT(lastPhBar, lastPh, phBar, pvH, false, smtTip)
    lastPh    := pvH
    lastPhCmp := cHi
    lastPhBar := phBar

// En mínimos: uno hace mínimo más bajo y el otro no → SMT alcista
if not na(pvL)
    int plBar = bar_index - smtLen
    if not na(lastPl) and not na(lastPlCmp) and not na(cLo) and plBar - lastPlBar <= smtMaxGap
        smtBull := smtShow and ((pvL < lastPl and cLo > lastPlCmp) or (pvL > lastPl and cLo < lastPlCmp))
        if smtBull
            f_drawSMT(lastPlBar, lastPl, plBar, pvL, true, smtTip)
    lastPl    := pvL
    lastPlCmp := cLo
    lastPlBar := plBar

// ═════════════════════════════ 1 · PERFIL DE LIQUIDEZ ══════════════════════
string vpTf        = vpAnchor == VP_DAY ? "D" : vpAnchor == VP_WEEK ? "W" : "M"
bool   vpPeriodic  = vpAnchor != VP_BARS
bool   vpAllowed   = vpShow and (not vpPeriodic or chartSec < timeframe.in_seconds(vpTf))
bool   vpNewPeriod = vpPeriodic and timeframe.change(vpTf)

var array<float>   vpH      = array.new<float>()
var array<float>   vpL      = array.new<float>()
var array<float>   vpV      = array.new<float>()
var array<bool>    vpUp     = array.new<bool>()
var int            vpStart  = na
var array<PocLine> prevPocs = array.new<PocLine>()

if vpAllowed
    if vpNewPeriod
        // POC del periodo que termina: queda dibujado (y se extiende si sigue virgen)
        if prevPocShow and array.size(vpH) > 0 and not na(vpStart)
            [pBtm, pStep, pBuy, pSell] = f_profile(vpH, vpL, vpV, vpUp, vpRows)
            [pRow, pMax] = f_pocRow(pBuy, pSell)
            if pRow >= 0 and pMax > 0
                float pPoc  = pBtm + (pRow + 0.5) * pStep
                line  pLine = line.new(vpStart, pPoc, bar_index - 1, pPoc, color = pocCol, width = pocWidth, style = f_lineStyle(pocStyle))
                array.unshift(prevPocs, PocLine.new(ln = pLine, price = pPoc))
                if array.size(prevPocs) > prevPocMax
                    PocLine oldPoc = array.pop(prevPocs)
                    line.delete(oldPoc.ln)
        array.clear(vpH)
        array.clear(vpL)
        array.clear(vpV)
        array.clear(vpUp)
        vpStart := bar_index
    if na(vpStart)
        vpStart := bar_index
    array.push(vpH, high)
    array.push(vpL, low)
    array.push(vpV, nz(volume))
    array.push(vpUp, close >= open)
    if not vpPeriodic and array.size(vpH) > vpLookback
        array.shift(vpH)
        array.shift(vpL)
        array.shift(vpV)
        array.shift(vpUp)

// POC vírgenes: se extienden hasta que el precio los toca
if array.size(prevPocs) > 0
    for p in prevPocs
        if p.naked
            if high >= p.price and low <= p.price
                p.naked := false
                line.set_x2(p.ln, bar_index)
            else if nakedPoc
                line.set_x2(p.ln, bar_index)

var array<box> vpBoxes = array.new<box>()
var line       vpPocLn = na
var line       vpVahLn = na
var line       vpValLn = na
var label      vpPocLb = na

if vpAllowed and barstate.islast and array.size(vpH) > 0
    for b in vpBoxes
        box.delete(b)
    array.clear(vpBoxes)
    if not na(vpPocLn)
        line.delete(vpPocLn)
    if not na(vpVahLn)
        line.delete(vpVahLn)
    if not na(vpValLn)
        line.delete(vpValLn)
    if not na(vpPocLb)
        label.delete(vpPocLb)
    [cBtm, cStep, cBuy, cSell] = f_profile(vpH, vpL, vpV, vpUp, vpRows)
    array<float> cTot = array.new<float>(vpRows, 0.0)
    for r = 0 to vpRows - 1
        array.set(cTot, r, array.get(cBuy, r) + array.get(cSell, r))
    float cMax = array.max(cTot)
    if cMax > 0 and cStep > 0
        int pocRow = array.indexof(cTot, cMax)
        [vaUp, vaDn] = f_valueArea(cTot, pocRow, vaPct)
        int startIdx = vpPeriodic ? vpStart : bar_index - array.size(vpH) + 1
        int x0       = vpPlace == VP_AT_START ? startIdx : bar_index + vpOffset
        int xEnd     = vpPlace == VP_AT_START ? bar_index : x0 + vpWidth
        for r = 0 to vpRows - 1
            float lo   = cBtm + r * cStep
            float hi   = lo + cStep * (1 - vpGap / 100)
            bool  inVA = not vaShow or (r >= vaDn and r <= vaUp)
            if vpMode == VP_TOTAL
                int w = int(math.round(array.get(cTot, r) / cMax * vpWidth))
                if w > 0
                    array.push(vpBoxes, box.new(x0, hi, x0 + w, lo, border_color = C_NONE, bgcolor = f_fade(vpTotCol, inVA)))
            else
                int wB = int(math.round(array.get(cBuy, r) / cMax * vpWidth))
                int wS = int(math.round(array.get(cSell, r) / cMax * vpWidth))
                if wB > 0
                    array.push(vpBoxes, box.new(x0, hi, x0 + wB, lo, border_color = C_NONE, bgcolor = f_fade(vpBuyCol, inVA)))
                if wS > 0
                    array.push(vpBoxes, box.new(x0 + wB, hi, x0 + wB + wS, lo, border_color = C_NONE, bgcolor = f_fade(vpSellCol, inVA)))
        if pocShow
            float pocPrice = cBtm + (pocRow + 0.5) * cStep
            vpPocLn := line.new(x0, pocPrice, xEnd, pocPrice, color = pocCol, width = pocWidth, style = f_lineStyle(pocStyle), extend = pocExtend ? extend.right : extend.none)
            if pocLabel
                vpPocLb := label.new(xEnd, pocPrice, "POC " + str.tostring(pocPrice, format.mintick), style = label.style_label_left, color = C_NONE, textcolor = pocCol, size = size.small)
        if vaShow and vaLines
            float vah = cBtm + (vaUp + 1) * cStep
            float val = cBtm + vaDn * cStep
            vpVahLn := line.new(x0, vah, xEnd, vah, color = vaLineCol, width = 1, style = f_lineStyle(vaLineStyle))
            vpValLn := line.new(x0, val, xEnd, val, color = vaLineCol, width = 1, style = f_lineStyle(vaLineStyle))

// ═════════════════════════════ ALERTAS ═════════════════════════════════════
// Confluencia: precio en zona SELL u OB bajista + SMT bajista + MSS bajista (y al revés)
var int lastSellCtx = na
var int lastBuyCtx  = na
var int lastSmtBear = na
var int lastSmtBull = na
if zoneSellTap or sInside
    lastSellCtx := bar_index
if zoneBuyTap or bInside
    lastBuyCtx := bar_index
if smtBear
    lastSmtBear := bar_index
if smtBull
    lastSmtBull := bar_index
bool anyMssDn = (swShift and swDn) or (inShift and inDn)
bool anyMssUp = (swShift and swUp) or (inShift and inUp)
bool confSell = anyMssDn and not na(lastSellCtx) and bar_index - lastSellCtx <= confWin and not na(lastSmtBear) and bar_index - lastSmtBear <= confWin
bool confBuy  = anyMssUp and not na(lastBuyCtx) and bar_index - lastBuyCtx <= confWin and not na(lastSmtBull) and bar_index - lastSmtBull <= confWin

alertcondition(confSell, "Confluencia bajista (zona + SMT + MSS)", "SMC Pro: confluencia BAJISTA en {{ticker}} ({{interval}}) a {{close}}")
alertcondition(confBuy, "Confluencia alcista (zona + SMT + MSS)", "SMC Pro: confluencia ALCISTA en {{ticker}} ({{interval}}) a {{close}}")
alertcondition(mssSwUp, "MSS swing alcista", "SMC Pro: MSS swing alcista en {{ticker}} ({{interval}})")
alertcondition(mssSwDn, "MSS swing bajista", "SMC Pro: MSS swing bajista en {{ticker}} ({{interval}})")
alertcondition(mssInUp, "MSS interno alcista", "SMC Pro: MSS interno alcista en {{ticker}} ({{interval}})")
alertcondition(mssInDn, "MSS interno bajista", "SMC Pro: MSS interno bajista en {{ticker}} ({{interval}})")
alertcondition(smtBull, "SMT alcista", "SMC Pro: SMT alcista en {{ticker}} ({{interval}})")
alertcondition(smtBear, "SMT bajista", "SMC Pro: SMT bajista en {{ticker}} ({{interval}})")
alertcondition(newBullOB, "Nuevo OB swing alcista", "SMC Pro: nuevo OB swing alcista en {{ticker}}")
alertcondition(newBearOB, "Nuevo OB swing bajista", "SMC Pro: nuevo OB swing bajista en {{ticker}}")
alertcondition(bFirstTouch, "Precio toca OB alcista", "SMC Pro: {{ticker}} toca un OB swing alcista")
alertcondition(sFirstTouch, "Precio toca OB bajista", "SMC Pro: {{ticker}} toca un OB swing bajista")
alertcondition(zoneSellTap and not zoneSellTap[1], "Precio entra en zona SELL", "SMC Pro: {{ticker}} entra en una zona SELL")
alertcondition(zoneBuyTap and not zoneBuyTap[1], "Precio entra en zona BUY", "SMC Pro: {{ticker}} entra en una zona BUY")
