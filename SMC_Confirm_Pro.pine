// 5 · Medición de la reacción
bool   statsOn  = input.bool(true, "Tabla de reacción de OB, zonas e iFVG", group = G_ST, tooltip = "Cuenta, tras el primer toque (el precio debe haber salido antes de la zona), cuántas veces el precio se aleja al menos X ATR antes de que una vela cierre al otro lado. Si ambas cosas pasan en la misma vela, cuenta como fallo.")
float  reactAtr = input.float(1.5, "Reacción mínima (ATR ×)", minval = 0.25, step = 0.25, group = G_ST)
string statsPos = input.string(POS_BR, "Posición", options = [POS_TR, POS_TL, POS_BR, POS_BL], group = G_ST)

// ═════════════════════════════ CÁLCULOS BASE ═══════════════════════════════
int   obBigLen  = math.min(obSwingLen * obBigMult, 450)
float atr       = ta.atr(14)
float ema200    = ta.ema(close, 200)
float volAvg    = ta.sma(volume, 20)
bool  hasVolume = ta.cum(nz(volume)) > 0
color C_NONE    = color.new(#000000, 100)

// ═════════════════════════════ TIPOS ═══════════════════════════════════════
type OB
    box   bx
    line  mid
    float top
    float btm
    int   dir
    float atrRef
    bool  aplus    = false
    bool  left     = false
    bool  touched  = false
    int   touchBar = na
    bool  resolved = false

type PocLine
    line  ln
    float price
    bool  naked = true

// FVG pendiente de invertirse
type Gap
    float top
    float btm
    int   left

// Dibujos de un perfil completo (para poder borrarlo entero)
type DayProfile
    array<box>   bxs
    array<line>  lns
    array<label> lbs

// ═════════════════════════════ FUNCIONES ═══════════════════════════════════
f_lineStyle(string s) => s == ST_SOLID ? line.style_solid : s == ST_DASHED ? line.style_dashed : line.style_dotted

f_size(string s) => s == SZ_AUTO ? size.auto : s == SZ_TINY ? size.tiny : s == SZ_SMALL ? size.small : size.normal

f_pos(string s) => s == POS_TR ? position.top_right : s == POS_TL ? position.top_left : s == POS_BR ? position.bottom_right : position.bottom_left

f_fmtVol(float v) => v >= 1000000 ? str.tostring(v / 1000000, "#.##") + "M" : v >= 1000 ? str.tostring(v / 1000, "#.##") + "K" : str.tostring(v, "#")

// Estructura de mercado. Un pivote máximo se confirma cuando el máximo de hace
// `len` velas supera a todas las posteriores (igual para mínimos).
// shift = true cuando la ruptura va contra la tendencia previa (MSS); si no, es BOS.
f_structure(int len) =>
    var int   leg     = 0
    var float topLvl  = na
    var int   topIdx  = na
    var bool  topOpen = false
    var float btmLvl  = na
    var int   btmIdx  = na
    var bool  btmOpen = false
    var int   trend   = 0
    float hh      = ta.highest(high, len)
    float ll      = ta.lowest(low, len)
    int   prevLeg = leg
    if high[len] > hh
        leg := 0
    else if low[len] < ll
        leg := 1
    if leg == 0 and prevLeg == 1
        topLvl  := high[len]
        topIdx  := bar_index - len
        topOpen := true
    if leg == 1 and prevLeg == 0
        btmLvl  := low[len]
        btmIdx  := bar_index - len
        btmOpen := true
    bool  brkUp  = topOpen and close > topLvl
    bool  brkDn  = not brkUp and btmOpen and close < btmLvl
    bool  shift  = false
    int   brkIdx = na
    float brkLvl = na
    if brkUp
        shift   := trend == -1
        trend   := 1
        topOpen := false
        brkIdx  := topIdx
        brkLvl  := topLvl
    else if brkDn
        shift   := trend == 1
        trend   := -1
        btmOpen := false
        brkIdx  := btmIdx
        brkLvl  := btmLvl
    [trend, brkUp, brkDn, shift, brkIdx, brkLvl]

// Valor de hace `i` velas guardado en un buffer (0 = vela actual).
// Los buffers evitan leer el historial con [] dentro de llamadas condicionales.
f_at(array<float> a, int i) => array.get(a, array.size(a) - 1 - i)

// Vela de origen del impulso: mínimo más bajo (alcista) o máximo más alto
// (bajista) entre el pivote roto y la vela actual. Devuelve [máximo, mínimo, desfase].
f_obCandle(array<float> hs, array<float> ls, bool bullish, int fromIdx) =>
    int   span = math.max(0, math.min(bar_index - fromIdx, array.size(hs) - 1))
    float ext  = bullish ? f_at(ls, 0) : f_at(hs, 0)
    int   off  = 0
    for i = 0 to span
        float v = bullish ? f_at(ls, i) : f_at(hs, i)
        if (bullish and v < ext) or (not bullish and v > ext)
            ext := v
            off := i
    [f_at(hs, off), f_at(ls, off), off]

// Calidad del OB con los criterios que mejoraron la reacción en datos reales:
// EMA 200 a favor, estructura mayor a favor, volumen del origen > media y BOS.
f_obQuality(array<float> vs, bool bullish, int off, float top, float btm, bool isShift, int bigTrend) =>
    int   nAfter = math.min(3, off)
    float vSum   = 0.0
    for i = off - nAfter to off
        vSum += f_at(vs, i)
    bool emaOk  = bullish ? close > ema200 : close < ema200
    bool bigOk  = bigTrend == (bullish ? 1 : -1)
    bool volOk  = not hasVolume or vSum / (nAfter + 1) > volAvg
    bool bosOk  = not isShift
    bool sizeOk = top - btm <= obMaxAtr * atr
    bool pass   = sizeOk and (not obNeedEma or emaOk) and (not obNeedBig or bigOk) and (not obNeedVol or volOk) and (not obNeedBos or bosOk)
    int  stars  = (emaOk ? 1 : 0) + (bigOk ? 1 : 0) + (volOk and hasVolume ? 1 : 0) + (bosOk ? 1 : 0)
    [pass, stars]

// Zonas de oferta / demanda de otra temporalidad (se evalúa con request.security).
// Solo se aceptan zonas a favor de la EMA 50 y de la estructura mayor de esa TF.
// Devuelve la última zona válida sin mitigar de cada lado, con velas ya cerradas.
f_mtfZones(int len, bool wickMitig, bool needEma, bool needBig) =>
    var array<float> hs = array.new<float>()
    var array<float> ls = array.new<float>()
    var array<int>   ts = array.new<int>()
    array.push(hs, high)
    array.push(ls, low)
    array.push(ts, time)
    if array.size(hs) > BUF
        array.shift(hs)
        array.shift(ls)
        array.shift(ts)
    [mTrend, mUp, mDn, mShift, mIdx, mLvl] = f_structure(len)
    [gTrend, gUp, gDn, gShift, gIdx, gLvl] = f_structure(len * 4)
    float e50 = ta.ema(close, 50)
    var float bearTop = na
    var float bearBtm = na
    var int   bearT   = na
    var float bullTop = na
    var float bullBtm = na
    var int   bullT   = na
    if mUp and (not needEma or close > e50) and (not needBig or gTrend == 1)
        [uH, uL, uOff] = f_obCandle(hs, ls, true, mIdx)
        bullTop := uH
        bullBtm := uL
        bullT   := array.get(ts, array.size(ts) - 1 - uOff)
    if mDn and (not needEma or close < e50) and (not needBig or gTrend == -1)
        [dH, dL, dOff] = f_obCandle(hs, ls, false, mIdx)
        bearTop := dH
        bearBtm := dL
        bearT   := array.get(ts, array.size(ts) - 1 - dOff)
    float upSrc = wickMitig ? high : close
    float dnSrc = wickMitig ? low : close
    if not na(bullBtm) and dnSrc < bullBtm
        bullTop := na
        bullBtm := na
        bullT   := na
    if not na(bearTop) and upSrc > bearTop
        bearTop := na
        bearBtm := na
        bearT   := na
    [bearTop[1], bearBtm[1], bearT[1], bullTop[1], bullBtm[1], bullT[1]]

f_tfLabel(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(int(s / 60)) : s < 86400 ? "H" + str.tostring(int(s / 3600)) : s < 604800 ? "D" + str.tostring(int(s / 86400)) : "W" + str.tostring(int(s / 604800))

// Dibuja una zona MTF (caja + texto + línea media) en la última vela
f_zone(array<box> bxs, array<line> lns, bool ok, float top, float btm, int t, string txt, color c) =>
    if ok and not na(top) and not na(btm) and not na(t)
        int rightT = time + znExt * timeframe.in_seconds() * 1000
        array.push(bxs, box.new(t, top, rightT, btm, xloc = xloc.bar_time, border_color = color.new(c, 40), bgcolor = color.new(c, znTransp), text = txt, text_color = znTxtCol, text_size = f_size(znTxtSize), text_halign = text.align_center, text_valign = text.align_center))
        if znMidOn
            float mid = (top + btm) / 2
            array.push(lns, line.new(t, mid, rightT, mid, xloc = xloc.bar_time, color = color.new(c, 30), style = f_lineStyle(znMidStyle)))
    true

// Mide la reacción de la zona MTF visible: primer toque tras salir de ella,
// reacción ≥ reactAtr·ATR (gana) o cierre al otro lado (pierde).
f_trackZone(float top, float btm, int t, bool bull, bool enabled) =>
    var int   zt     = na
    var float zTop   = na
    var float zBtm   = na
    var float zAtr   = na
    var bool  zLeft  = false
    var bool  zTouch = false
    var int   zTBar  = na
    var bool  zDone  = true
    int  win   = 0
    int  loss  = 0
    bool first = false
    if enabled and not na(t) and not na(top) and not na(btm) and (na(zt) or t != zt or top != zTop or btm != zBtm)
        zt     := t
        zTop   := top
        zBtm   := btm
        zAtr   := atr
        zLeft  := false
        zTouch := false
        zTBar  := na
        zDone  := false
    if enabled and not zDone
        bool inZone = high >= zBtm and low <= zTop
        if not zLeft and (bull ? low > zTop : high < zBtm)
            zLeft := true
        if not zTouch and zLeft and inZone
            zTouch := true
            zTBar  := bar_index
            first  := true
        if bull ? close < zBtm : close > zTop
            if zTouch
                loss := 1
            zDone := true
        else if zTouch and bar_index > zTBar and (bull ? high >= zTop + reactAtr * zAtr : low <= zBtm - reactAtr * zAtr)
            win   := 1
            zDone := true
    [win, loss, first]

// Gestiona los OB / iFVG activos: salida de la zona, primer toque, reacción y
// mitigación. Devuelve los resultados de todos y, aparte, los de los OB A+.
f_manageOBs(array<OB> arr, string mitMode, bool delMit) =>
    int  wins    = 0
    int  losses  = 0
    int  winsA   = 0
    int  lossesA = 0
    bool firstT  = false
    bool firstA  = false
    int  n       = array.size(arr)
    if n > 0
        for i = n - 1 to 0
            OB    o      = array.get(arr, i)
            bool  bull   = o.dir == 1
            float srcM   = mitMode == MIT_CLOSE ? close : bull ? low : high
            bool  inZone = high >= o.btm and low <= o.top
            bool  mitig  = bull ? srcM < o.btm : srcM > o.top
            // El toque solo cuenta si antes el precio salió por completo de la zona
            if not o.left and (bull ? low > o.top : high < o.btm)
                o.left := true
            if not o.touched and o.left and inZone
                o.touched  := true
                o.touchBar := bar_index
                firstT     := true
                if o.aplus
                    firstA := true
            if mitig
                // Supuesto conservador: mitigación antes que reacción en la misma vela
                if o.touched and not o.resolved
                    o.resolved := true
                    losses     += 1
                    if o.aplus
                        lossesA += 1
                box.set_right(o.bx, bar_index)
                if not na(o.mid)
                    line.set_x2(o.mid, bar_index)
                if delMit
                    box.delete(o.bx)
                    if not na(o.mid)
                        line.delete(o.mid)
                array.remove(arr, i)
            else
                if o.touched and not o.resolved and bar_index > o.touchBar
                    bool reacted = bull ? high >= o.top + reactAtr * o.atrRef : low <= o.btm - reactAtr * o.atrRef
                    if reacted
                        o.resolved := true
                        wins       += 1
                        if o.aplus
                            winsA += 1
                box.set_right(o.bx, bar_index)
                if not na(o.mid)
                    line.set_x2(o.mid, bar_index)
    [wins, losses, winsA, lossesA, firstT, firstA]

// ¿Se solapa el OB con una zona de TF superior válida?
f_ov(bool ok, float zTop, float zBtm, float top, float btm) => ok and not na(zTop) and not na(zBtm) and math.max(zBtm, btm) <= math.min(zTop, top)


f_overlaps(array<OB> arr, float top, float btm) =>
    bool hit = false
    if array.size(arr) > 0
        for o in arr
            if math.max(o.btm, btm) <= math.min(o.top, top)
                hit := true
    hit

// Crea un iFVG (dir 1 = soporte alcista, -1 = resistencia bajista)
f_addIfvg(array<OB> arr, float top, float btm, int leftIdx, int dir) =>
    color c  = dir == 1 ? ifBullCol : ifBearCol
    float mp = (top + btm) / 2
    box   bx = box.new(leftIdx, top, bar_index, btm, border_color = color.new(c, 40), bgcolor = c, text = ifTextOn ? "iFVG" : "", text_color = ifTxtCol, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
    line  md = ifMidOn ? line.new(leftIdx, mp, bar_index, mp, color = color.new(c, 20), style = line.style_dashed) : na
    array.unshift(arr, OB.new(bx = bx, mid = md, top = top, btm = btm, dir = dir, atrRef = atr))
    if array.size(arr) > ifMaxActive
        array.pop(arr)
    true

// Revisa los FVG pendientes: los caducados se descartan y los que una vela
// cierra al otro lado se convierten en iFVG de dirección contraria.
f_invertGaps(array<Gap> gaps, array<OB> target, bool gapBull, int bigT) =>
    bool created = false
    int  n       = array.size(gaps)
    if n > 0
        for i = n - 1 to 0
            Gap g = array.get(gaps, i)
            if bar_index - g.left > ifMaxAge
                array.remove(gaps, i)
            else if gapBull ? close < g.btm : close > g.top
                array.remove(gaps, i)
                int  nd = gapBull ? -1 : 1
                bool ok = (not ifNeedEma or (nd == 1 ? close > ema200 : close < ema200)) and (not ifNeedBig or bigT == nd) and g.top - g.btm <= ifMaxAtr * atr
                if ok and not f_overlaps(target, g.top, g.btm)
                    f_addIfvg(target, g.top, g.btm, g.left, nd)
                    created := true
    created

// Perfil: reparte el volumen de cada vela entre las filas de precio que cubre
f_profile(array<float> hs, array<float> ls, array<float> vs, array<bool> ups, int rows) =>
    float top   = array.max(hs)
    float btm   = array.min(ls)
    float step  = (top - btm) / rows
    array<float> buyV  = array.new<float>(rows, 0.0)
    array<float> sellV = array.new<float>(rows, 0.0)
    if step > 0
        for i = 0 to array.size(hs) - 1
            float h   = array.get(hs, i)
            float l   = array.get(ls, i)
            float v   = array.get(vs, i)
            bool  up  = array.get(ups, i)
            int   r0  = math.max(0, math.min(rows - 1, int(math.floor((l - btm) / step))))
            int   r1  = math.max(0, math.min(rows - 1, int(math.floor((h - btm) / step))))
            float rng = h - l
            for r = r0 to r1
                float rowLo = btm + r * step
                float share = rng > 0 ? math.max(math.min(h, rowLo + step) - math.max(l, rowLo), 0) / rng : 1.0 / (r1 - r0 + 1)
                if up
                    array.set(buyV, r, array.get(buyV, r) + v * share)
                else
                    array.set(sellV, r, array.get(sellV, r) + v * share)
    [btm, step, buyV, sellV]

f_pocRow(array<float> buyV, array<float> sellV) =>
    float maxV = 0.0
    int   row  = -1
    for r = 0 to array.size(buyV) - 1
        float t = array.get(buyV, r) + array.get(sellV, r)
        if t > maxV
            maxV := t
            row  := r
    [row, maxV]

// Value area: crece desde el POC hacia la fila vecina con más volumen
f_valueArea(array<float> tot, int pocRow, float pct) =>
    int   n      = array.size(tot)
    float target = array.sum(tot) * pct / 100
    float acc    = array.get(tot, pocRow)
    int   up     = pocRow
    int   dn     = pocRow
    while acc < target and (up < n - 1 or dn > 0)
        float vUp = up < n - 1 ? array.get(tot, up + 1) : -1.0
        float vDn = dn > 0 ? array.get(tot, dn - 1) : -1.0
        if vUp >= vDn
            up  += 1
            acc += vUp
        else
            dn  -= 1
            acc += vDn
    [up, dn]

f_fade(color c, bool keep) => keep ? c : color.new(c, math.min(100, color.t(c) + vaOutTransp))

// Dibuja un perfil completo: barras de compradores y vendedores por fila,
// texto opcional (compras × ventas y total), POC y líneas VAH / VAL.
f_drawProfile(array<float> hs, array<float> ls, array<float> vs, array<bool> ups, int x0, int xEnd, int wMax, bool withText, bool isCurrent) =>
    DayProfile dp = DayProfile.new(array.new<box>(), array.new<line>(), array.new<label>())
    [cBtm, cStep, cBuy, cSell] = f_profile(hs, ls, vs, ups, vpRows)
    array<float> cTot = array.new<float>(vpRows, 0.0)
    for r = 0 to vpRows - 1
        array.set(cTot, r, array.get(cBuy, r) + array.get(cSell, r))
    float cMax = array.max(cTot)
    if cMax > 0 and cStep > 0
        int pocRow = array.indexof(cTot, cMax)
        [vaUp, vaDn] = f_valueArea(cTot, pocRow, vaPct)
        string tSize = f_size(vpTextSize)
        for r = 0 to vpRows - 1
            float lo   = cBtm + r * cStep
            float hi   = lo + cStep * (1 - vpGap / 100)
            float bv   = array.get(cBuy, r)
            float sv   = array.get(cSell, r)
            bool  inVA = not vaShow or (r >= vaDn and r <= vaUp)
            if vpMode == VP_TOTAL
                int w = int(math.round((bv + sv) / cMax * wMax))
                if w > 0
                    array.push(dp.bxs, box.new(x0, hi, x0 + w, lo, border_color = C_NONE, bgcolor = f_fade(vpTotCol, inVA)))
            else
                int wB = int(math.round(bv / cMax * wMax))
                int wS = int(math.round(sv / cMax * wMax))
                if wB > 0
                    array.push(dp.bxs, box.new(x0, hi, x0 + wB, lo, border_color = C_NONE, bgcolor = f_fade(vpBuyCol, inVA)))
                if wS > 0
                    array.push(dp.bxs, box.new(x0 + wB, hi, x0 + wB + wS, lo, border_color = C_NONE, bgcolor = f_fade(vpSellCol, inVA)))
            if withText
                array.push(dp.bxs, box.new(x0, hi, x0 + wMax, lo, border_color = C_NONE, bgcolor = C_NONE, text = f_fmtVol(bv) + " × " + f_fmtVol(sv), text_color = vpTextCol, text_size = tSize, text_halign = text.align_left, text_valign = text.align_center, text_wrap = text.wrap_none))
        if withText and vpTotalOn
            float tHi = cBtm - cStep * 0.1
            float tLo = cBtm - cStep * 1.1
            array.push(dp.bxs, box.new(x0, tHi, x0 + wMax, tLo, border_color = C_NONE, bgcolor = C_NONE, text = f_fmtVol(array.sum(cBuy)) + " × " + f_fmtVol(array.sum(cSell)), text_color = vpTotalCol, text_size = tSize, text_halign = text.align_left, text_valign = text.align_center, text_wrap = text.wrap_none))
        if pocShow
            float pocPrice = cBtm + (pocRow + 0.5) * cStep
            array.push(dp.lns, line.new(x0, pocPrice, xEnd, pocPrice, color = pocCol, width = pocWidth, style = f_lineStyle(pocStyle), extend = isCurrent and pocExtend ? extend.right : extend.none))
            if isCurrent and pocLabel
                array.push(dp.lbs, label.new(xEnd, pocPrice, "POC " + str.tostring(pocPrice, format.mintick), style = label.style_label_left, color = C_NONE, textcolor = pocCol, size = size.small))
        if vaShow and vaLines
            float vah = cBtm + (vaUp + 1) * cStep
            float val = cBtm + vaDn * cStep
            array.push(dp.lns, line.new(x0, vah, xEnd, vah, color = vaLineCol, width = vaLineWidth, style = f_lineStyle(vaLineStyle)))
            array.push(dp.lns, line.new(x0, val, xEnd, val, color = vaLineCol, width = vaLineWidth, style = f_lineStyle(vaLineStyle)))
    dp

f_deleteProfile(DayProfile dp) =>
    for b in dp.bxs
        box.delete(b)
    for l in dp.lns
        line.delete(l)
    for lb in dp.lbs
        label.delete(lb)
    true

// ═════════════════════════════ 2 · ZONAS BUY / SELL (datos) ════════════════
// Se calculan antes que los OB para poder detectar la confluencia (OB A+)
int  chartSec = timeframe.in_seconds()
bool tf1Val   = tf1On and timeframe.in_seconds(tf1) >= chartSec
bool tf2Val   = tf2On and timeframe.in_seconds(tf2) >= chartSec
bool tf3Val   = tf3On and timeframe.in_seconds(tf3) >= chartSec
bool tf4Val   = tf4On and timeframe.in_seconds(tf4) >= chartSec
bool tf1Ok    = znShow and tf1Val
bool tf2Ok    = znShow and tf2Val
bool tf3Ok    = znShow and tf3Val
bool tf4Ok    = znShow and tf4Val
bool znWick   = znMitig == MIT_WICK

[z1BearTop, z1BearBtm, z1BearT, z1BullTop, z1BullBtm, z1BullT] = request.security(syminfo.tickerid, tf1, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)
[z2BearTop, z2BearBtm, z2BearT, z2BullTop, z2BullBtm, z2BullT] = request.security(syminfo.tickerid, tf2, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)
[z3BearTop, z3BearBtm, z3BearT, z3BullTop, z3BullBtm, z3BullT] = request.security(syminfo.tickerid, tf3, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)
[z4BearTop, z4BearBtm, z4BearT, z4BullTop, z4BullBtm, z4BullT] = request.security(syminfo.tickerid, tf4, f_mtfZones(znLen, znWick, znNeedEma, znNeedBig), lookahead = barmerge.lookahead_on)

// ═════════════════════════════ 3 · ORDER BLOCKS SWING ══════════════════════
[obTrend, obUp, obDn, obShift, obIdx, obLvl] = f_structure(obSwingLen)
[bigTrend, bigUp, bigDn, bigShift, bigIdx, bigLvl] = f_structure(obBigLen)

var array<OB>    bullOBs  = array.new<OB>()
var array<OB>    bearOBs  = array.new<OB>()
var int          obWins   = 0
var int          obLosses = 0
var int          obWinsA  = 0
var int          obLossA  = 0
var array<float> bufH     = array.new<float>()
var array<float> bufL     = array.new<float>()
var array<float> bufV     = array.new<float>()
array.push(bufH, high)
array.push(bufL, low)
array.push(bufV, nz(volume))
if array.size(bufH) > BUF
    array.shift(bufH)
    array.shift(bufL)
    array.shift(bufV)

// 1) Salidas, toques, reacciones y mitigaciones (antes de crear los de esta vela)
[bWins, bLosses, bWinsA, bLossA, bFirstTouch, bFirstA] = f_manageOBs(bullOBs, obMitig, obDelMitig)
[sWins, sLosses, sWinsA, sLossA, sFirstTouch, sFirstA] = f_manageOBs(bearOBs, obMitig, obDelMitig)
obWins   += bWins + sWins
obLosses += bLosses + sLosses
obWinsA  += bWinsA + sWinsA
obLossA  += bLossA + sLossA

// 2) Nuevo OB en cada ruptura swing, solo si pasa los filtros
bool newBullOB = false
bool newBearOB = false
bool newAplus  = false
if obShow and (obUp or obDn)
    [oTop, oBtm, oOff] = f_obCandle(bufH, bufL, obUp, obIdx)
    [oPass, oStars]    = f_obQuality(bufV, obUp, oOff, oTop, oBtm, obShift, bigTrend)
    array<OB> target   = obUp ? bullOBs : bearOBs
    if oPass and not f_overlaps(target, oTop, oBtm)
        // A+: el OB está dentro de una zona BUY (alcista) o SELL (bajista) de TF superior
        bool   confBuy  = f_ov(tf1Val, z1BullTop, z1BullBtm, oTop, oBtm) or f_ov(tf2Val, z2BullTop, z2BullBtm, oTop, oBtm) or f_ov(tf3Val, z3BullTop, z3BullBtm, oTop, oBtm) or f_ov(tf4Val, z4BullTop, z4BullBtm, oTop, oBtm)
        bool   confSell = f_ov(tf1Val, z1BearTop, z1BearBtm, oTop, oBtm) or f_ov(tf2Val, z2BearTop, z2BearBtm, oTop, oBtm) or f_ov(tf3Val, z3BearTop, z3BearBtm, oTop, oBtm) or f_ov(tf4Val, z4BearTop, z4BearBtm, oTop, oBtm)
        bool   aplus    = obAplusOn and (obUp ? confBuy : confSell)
        color  c        = obUp ? obBullCol : obBearCol
        string txt      = obTextOn ? (aplus ? "OB A+ " : "OB ") + str.repeat("★", oStars) : ""
        float  midP     = (oTop + oBtm) / 2
        box    bx       = box.new(bar_index - oOff, oTop, bar_index, oBtm, border_color = color.new(c, aplus ? 0 : 30), border_width = aplus ? 2 : 1, bgcolor = c, text = txt, text_color = obTxtCol, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
        line   md       = obMidOn ? line.new(bar_index - oOff, midP, bar_index, midP, color = color.new(c, 20), style = f_lineStyle(obMidStyle)) : na
        array.unshift(target, OB.new(bx = bx, mid = md, top = oTop, btm = oBtm, dir = obUp ? 1 : -1, atrRef = atr, aplus = aplus))
        if array.size(target) > obMaxActive
            array.pop(target)
        newBullOB := obUp
        newBearOB := obDn
        newAplus  := aplus

// ═════════════════════════════ 4 · iFVG ════════════════════════════════════
var array<Gap> gapsUp   = array.new<Gap>()   // FVG alcistas pendientes de invertirse
var array<Gap> gapsDn   = array.new<Gap>()   // FVG bajistas pendientes de invertirse
var array<OB>  ifBull   = array.new<OB>()    // iFVG alcistas (soporte)
var array<OB>  ifBear   = array.new<OB>()    // iFVG bajistas (resistencia)
var int        ifWins   = 0
var int        ifLosses = 0
float h2 = high[2]
float l2 = low[2]

// 1) Toques, reacciones e invalidaciones de los iFVG activos
[ibW, ibL, ibWA, ibLA, ibFirst, ibFirstA] = f_manageOBs(ifBull, ifMitig, ifDelMitig)
[isW, isL, isWA, isLA, isFirst, isFirstA] = f_manageOBs(ifBear, ifMitig, ifDelMitig)
ifWins   += ibW + isW
ifLosses += ibL + isL

// 2) Inversión de FVG y registro de los FVG nuevos de esta vela
bool newIfBear = false
bool newIfBull = false
if ifShow
    newIfBear := f_invertGaps(gapsUp, ifBear, true, bigTrend)
    newIfBull := f_invertGaps(gapsDn, ifBull, false, bigTrend)
    if low > h2 and low - h2 >= ifMinAtr * atr
        array.unshift(gapsUp, Gap.new(low, h2, bar_index - 2))
        if array.size(gapsUp) > 30
            array.pop(gapsUp)
    if high < l2 and l2 - high >= ifMinAtr * atr
        array.unshift(gapsDn, Gap.new(l2, high, bar_index - 2))
        if array.size(gapsDn) > 30
            array.pop(gapsDn)

// ═════════════════════════════ 2 · ZONAS BUY / SELL (medición y dibujo) ════
// Medición de la reacción de cada zona visible (8 = 4 temporalidades × 2 lados)
[w1s, l1s, f1s] = f_trackZone(z1BearTop, z1BearBtm, z1BearT, false, tf1Ok and znSellOn)
[w1b, l1b, f1b] = f_trackZone(z1BullTop, z1BullBtm, z1BullT, true, tf1Ok and znBuyOn)
[w2s, l2s, f2s] = f_trackZone(z2BearTop, z2BearBtm, z2BearT, false, tf2Ok and znSellOn)
[w2b, l2b, f2b] = f_trackZone(z2BullTop, z2BullBtm, z2BullT, true, tf2Ok and znBuyOn)
[w3s, l3s, f3s] = f_trackZone(z3BearTop, z3BearBtm, z3BearT, false, tf3Ok and znSellOn)
[w3b, l3b, f3b] = f_trackZone(z3BullTop, z3BullBtm, z3BullT, true, tf3Ok and znBuyOn)
[w4s, l4s, f4s] = f_trackZone(z4BearTop, z4BearBtm, z4BearT, false, tf4Ok and znSellOn)
[w4b, l4b, f4b] = f_trackZone(z4BullTop, z4BullBtm, z4BullT, true, tf4Ok and znBuyOn)

var int znWins   = 0
var int znLosses = 0
znWins   += w1s + w1b + w2s + w2b + w3s + w3b + w4s + w4b
znLosses += l1s + l1b + l2s + l2b + l3s + l3b + l4s + l4b
bool zoneSellTouch = f1s or f2s or f3s or f4s
bool zoneBuyTouch  = f1b or f2b or f3b or f4b

var array<box>  znBoxes = array.new<box>()
var array<line> znLines = array.new<line>()
if znShow and barstate.islast
    for b in znBoxes
        box.delete(b)
    for l in znLines
        line.delete(l)
    array.clear(znBoxes)
    array.clear(znLines)
    f_zone(znBoxes, znLines, tf1Ok and znSellOn, z1BearTop, z1BearBtm, z1BearT, f_tfLabel(tf1) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf1Ok and znBuyOn, z1BullTop, z1BullBtm, z1BullT, f_tfLabel(tf1) + " BUY", znBuyCol)
    f_zone(znBoxes, znLines, tf2Ok and znSellOn, z2BearTop, z2BearBtm, z2BearT, f_tfLabel(tf2) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf2Ok and znBuyOn, z2BullTop, z2BullBtm, z2BullT, f_tfLabel(tf2) + " BUY", znBuyCol)
    f_zone(znBoxes, znLines, tf3Ok and znSellOn, z3BearTop, z3BearBtm, z3BearT, f_tfLabel(tf3) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf3Ok and znBuyOn, z3BullTop, z3BullBtm, z3BullT, f_tfLabel(tf3) + " BUY", znBuyCol)
    f_zone(znBoxes, znLines, tf4Ok and znSellOn, z4BearTop, z4BearBtm, z4BearT, f_tfLabel(tf4) + " SELL", znSellCol)
    f_zone(znBoxes, znLines, tf4Ok and znBuyOn, z4BullTop, z4BullBtm, z4BullT, f_tfLabel(tf4) + " BUY", znBuyCol)

// ═════════════════════════════ 1 · PERFIL DE LIQUIDEZ ══════════════════════
string vpTf        = vpAnchor == VP_DAY ? "D" : vpAnchor == VP_WEEK ? "W" : "M"
bool   vpPeriodic  = vpAnchor != VP_BARS
bool   vpAllowed   = vpShow and (not vpPeriodic or chartSec < timeframe.in_seconds(vpTf))
bool   vpNewPeriod = vpPeriodic and timeframe.change(vpTf)

var array<float>   vpH      = array.new<float>()
var array<float>   vpL      = array.new<float>()
var array<float>   vpV      = array.new<float>()
var array<bool>    vpUp     = array.new<bool>()
var int            vpStart  = na
var array<PocLine> prevPocs = array.new<PocLine>()
var array<DayProfile> pastProfiles = array.new<DayProfile>()

if vpAllowed
    if vpNewPeriod
        // POC del periodo que termina (opcional): queda dibujado como referencia
        if prevPocShow and array.size(vpH) > 0 and not na(vpStart)
            [pBtm, pStep, pBuy, pSell] = f_profile(vpH, vpL, vpV, vpUp, vpRows)
            [pRow, pMax] = f_pocRow(pBuy, pSell)
            if pRow >= 0 and pMax > 0
                float pPoc  = pBtm + (pRow + 0.5) * pStep
                line  pLine = line.new(vpStart, pPoc, bar_index - 1, pPoc, color = pocCol, width = pocWidth, style = f_lineStyle(pocStyle))
                array.unshift(prevPocs, PocLine.new(ln = pLine, price = pPoc))
                if array.size(prevPocs) > prevPocMax
                    PocLine oldPoc = array.pop(prevPocs)
                    line.delete(oldPoc.ln)
        // Perfil completo del periodo que termina (se guardan los N últimos)
        if vpPastDays > 0 and array.size(vpH) > 0 and not na(vpStart)
            int dayBars = bar_index - 1 - vpStart
            array.push(pastProfiles, f_drawProfile(vpH, vpL, vpV, vpUp, vpStart, bar_index - 1, math.min(vpWidth, math.max(5, dayBars)), vpPastText, false))
            if array.size(pastProfiles) > vpPastDays
                f_deleteProfile(array.shift(pastProfiles))
        // Empieza el perfil del nuevo periodo
        array.clear(vpH)
        array.clear(vpL)
        array.clear(vpV)
        array.clear(vpUp)
        vpStart := bar_index
    if na(vpStart)
        vpStart := bar_index
    array.push(vpH, high)
    array.push(vpL, low)
    array.push(vpV, nz(volume))
    array.push(vpUp, close >= open)
    if not vpPeriodic and array.size(vpH) > vpLookback
        array.shift(vpH)
        array.shift(vpL)
        array.shift(vpV)
        array.shift(vpUp)

// POC anteriores vírgenes: se extienden hasta que el precio los toca
if array.size(prevPocs) > 0
    for p in prevPocs
        if p.naked
            if high >= p.price and low <= p.price
                p.naked := false
                line.set_x2(p.ln, bar_index)
            else if nakedPoc
                line.set_x2(p.ln, bar_index)

// Perfil del periodo en curso: se rehace en cada tick (tiempo real)
var DayProfile curProfile = na
if vpAllowed and barstate.islast and array.size(vpH) > 0
    if not na(curProfile)
        f_deleteProfile(curProfile)
    int startIdx = vpPeriodic ? vpStart : bar_index - array.size(vpH) + 1
    int x0       = vpPlace == VP_AT_START ? startIdx : bar_index + vpOffset
    int xEnd     = vpPlace == VP_AT_START ? bar_index : x0 + vpWidth
    curProfile := f_drawProfile(vpH, vpL, vpV, vpUp, x0, xEnd, vpWidth, vpTextOn, true)

// ═════════════════════════════ TABLA DE REACCIÓN ═══════════════════════════
// Una fila de la tabla: nombre, % de acierto y número de toques resueltos
f_statRow(table t, int r, string name, int w, int lo) =>
    color  txtC = color.new(#e2e8f0, 0)
    int    res  = w + lo
    string pct  = res > 0 ? str.tostring(100.0 * w / res, "0") + "%" : "—"
    table.cell(t, 0, r, name, text_color = txtC, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, pct, text_color = res > 0 and w >= lo ? color.new(#089981, 0) : color.new(#f23645, 0), text_size = size.small)
    table.cell(t, 2, r, str.tostring(res) + (res < 30 ? " · poca muestra" : ""), text_color = res < 30 ? color.orange : txtC, text_size = size.tiny)

var table stTbl = table.new(f_pos(statsPos), 3, 5, bgcolor = color.new(#0f172a, 15), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)
if statsOn and barstate.islast and (obShow or znShow or ifShow)
    color txtH = color.new(#e2e8f0, 0)
    table.cell(stTbl, 0, 0, "Reacción ≥ " + str.tostring(reactAtr) + " ATR", text_color = txtH, text_size = size.small, text_halign = text.align_left)
    table.cell(stTbl, 1, 0, "acierto", text_color = txtH, text_size = size.tiny)
    table.cell(stTbl, 2, 0, "toques", text_color = txtH, text_size = size.tiny)
    f_statRow(stTbl, 1, "OB swing (todos)", obWins, obLosses)
    f_statRow(stTbl, 2, "OB A+ (en zona TF sup.)", obWinsA, obLossA)
    f_statRow(stTbl, 3, "Zonas BUY / SELL", znWins, znLosses)
    f_statRow(stTbl, 4, "iFVG", ifWins, ifLosses)

// ═════════════════════════════ ALERTAS ═════════════════════════════════════
alertcondition(newBullOB, "Nuevo OB swing alcista", "SMC Pro: nuevo OB swing alcista en {{ticker}} ({{interval}})")
alertcondition(newBearOB, "Nuevo OB swing bajista", "SMC Pro: nuevo OB swing bajista en {{ticker}} ({{interval}})")
alertcondition(newAplus, "Nuevo OB A+ (en zona de TF superior)", "SMC Pro: nuevo OB A+ en {{ticker}} ({{interval}}), dentro de una zona de temporalidad superior")
alertcondition(bFirstTouch, "Precio toca OB alcista", "SMC Pro: {{ticker}} vuelve a un OB swing alcista ({{close}})")
alertcondition(sFirstTouch, "Precio toca OB bajista", "SMC Pro: {{ticker}} vuelve a un OB swing bajista ({{close}})")
alertcondition(bFirstA or sFirstA, "Precio toca OB A+", "SMC Pro: {{ticker}} vuelve a un OB A+ ({{close}})")
alertcondition(zoneBuyTouch, "Precio toca zona BUY", "SMC Pro: {{ticker}} vuelve a una zona BUY ({{close}})")
alertcondition(zoneSellTouch, "Precio toca zona SELL", "SMC Pro: {{ticker}} vuelve a una zona SELL ({{close}})")
alertcondition(newIfBull, "Nuevo iFVG alcista", "SMC Pro: nuevo iFVG alcista (soporte) en {{ticker}} ({{interval}})")
alertcondition(newIfBear, "Nuevo iFVG bajista", "SMC Pro: nuevo iFVG bajista (resistencia) en {{ticker}} ({{interval}})")
alertcondition(ibFirst or isFirst, "Precio toca iFVG", "SMC Pro: {{ticker}} vuelve a un iFVG ({{close}})")
