//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  SMC Confirm Pro · Pine Script v6
//  Solo cinco herramientas, todas configurables:
//   1) Perfil de liquidez (volumen por precio) con POC, value area y POC vírgenes
//   2) Zonas SELL / BUY de temporalidades superiores ("M15 SELL", "H1 BUY"...)
//   3) Order blocks swing fuertes: filtros de calidad + medición de su reacción
//   4) SMT: divergencia con un activo correlacionado (NQ↔ES, oro↔plata...)
//   5) MSS: cambios de estructura (swing e interno) bien marcados
//  Sin repintado: pivotes confirmados y zonas MTF con [1] + lookahead_on.
//  No es asesoramiento financiero. Valida fuera de muestra antes de operar.
// ════════════════════════════════════════════════════════════════════════════
indicator("SMC Confirm Pro", shorttitle = "SMC Pro", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ─────────────────────────────── Constantes ────────────────────────────────
const string G_VP  = "1 · Perfil de liquidez"
const string G_ZN  = "2 · Zonas SELL / BUY"
const string G_OB  = "3 · Order blocks swing fuertes"
const string G_SMT = "4 · SMT (divergencia entre activos)"
const string G_MSS = "5 · MSS (cambio de estructura)"

const string ST_SOLID    = "Continua"
const string ST_DASHED   = "Discontinua"
const string ST_DOTTED   = "Punteada"
const string SZ_TINY     = "Diminuto"
const string SZ_SMALL    = "Pequeño"
const string SZ_NORMAL   = "Normal"
const string POS_TR      = "Arriba derecha"
const string POS_TL      = "Arriba izquierda"
const string POS_BR      = "Abajo derecha"
const string POS_BL      = "Abajo izquierda"
const string VP_DAY      = "Día"
const string VP_WEEK     = "Semana"
const string VP_MONTH    = "Mes"
const string VP_BARS     = "Últimas N velas"
const string VP_AT_START = "Inicio del periodo"
const string VP_AT_RIGHT = "A la derecha del precio"
const string VP_SPLIT    = "Compras / ventas"
const string VP_TOTAL    = "Total"
