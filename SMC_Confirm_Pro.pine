color  ifBullCol   = input.color(color.new(#089981, 80), "Alcista", group = G_IF, inline = "ic")
color  ifBearCol   = input.color(color.new(#f23645, 80), "Bajista", group = G_IF, inline = "ic")
bool   ifTextOn    = input.bool(true, "Texto iFVG", group = G_IF, inline = "it")
