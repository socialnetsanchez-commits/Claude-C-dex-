bool   vaLines     = input.bool(true, "Líneas VAH / VAL", group = G_VP, inline = "val")
color  vaLineCol   = input.color(color.new(#787b86, 20), "", group = G_VP, inline = "val")
string vaLineStyle = input.string(ST_DASHED, "", options = [ST_SOLID, ST_DASHED, ST_DOTTED], group = G_VP, inline = "val")
bool   pocShow     = input.bool(true, "POC", group = G_VP, inline = "poc")
